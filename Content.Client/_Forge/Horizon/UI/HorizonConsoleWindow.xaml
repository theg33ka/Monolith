<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="680 560"
                      MinSize="560 440">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="StatusLabel" Text="Horizon offline" />
        <GridContainer Columns="2" HSeparationOverride="12" VSeparationOverride="4">
            <Label Text="{Loc 'horizon-console-organization'}" />
            <Label Name="OrganizationLabel" HorizontalAlignment="Right" />
            <Label Text="{Loc 'horizon-console-access'}" />
            <Label Name="AccessLabel" HorizontalAlignment="Right" />
            <Label Text="{Loc 'horizon-console-resources'}" />
            <Label Name="ResourcesLabel" HorizontalAlignment="Right" />
            <Label Text="{Loc 'horizon-console-counts'}" />
            <Label Name="CountsLabel" HorizontalAlignment="Right" />
        </GridContainer>
        <PanelContainer HorizontalExpand="True">
            <Label Name="NeedLabel" Margin="6" />
        </PanelContainer>
        <PanelContainer Name="WanderingAiPanel" HorizontalExpand="True" Visible="False">
            <Label Name="WanderingAiLabel" Margin="6" HorizontalExpand="True" />
        </PanelContainer>
        <Label Text="{Loc 'horizon-console-diagnostics'}" />
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
            <Label Name="DiagnosticsLabel" HorizontalExpand="True" />
        </ScrollContainer>
        <Label Name="ContributionHintLabel" />
        <Button Name="HandoffButton" Access="Public" Text="{Loc 'horizon-console-ai-handoff'}" Visible="False" />
        <Button Name="RefreshButton" Access="Public" Text="{Loc 'horizon-console-refresh'}" />
    </BoxContainer>
</controls:FancyWindow>
