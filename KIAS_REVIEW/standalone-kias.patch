+        foreach ($variant in @('A','B')) {
+            $preflightRun = Join-Path $preflight $variant
+            & (Join-Path $PSScriptRoot 'native_replay.ps1') -Variant $variant -Ships 40 -WarmupTicks 1800 -MeasuredTicks 1200 -Scenario $preflightScenario -OutputDirectory $preflightRun -ManifestPath $manifestPath -Seed $Seed -AdminLogProbe 6000
+            & python (Join-Path $PSScriptRoot 'validate_adminlog_probe.py') $preflightRun
+            if ($LASTEXITCODE -ne 0) { throw "Админ-логи $variant не прошли проверку сохранения." }
+        }
+        } elseif (-not $Diagnostic) {
+            Write-Host 'Игровые проверки свежей пары A/B перед полной серией...'
+            & (Join-Path $PSScriptRoot 'native_suite.ps1') -Variants @('A','B') -Ships 1 -OutputDirectory (Join-Path $current 'native-preflight') -ManifestPath $manifestPath -Seed $Seed
+            $taskNetworkScenario=Join-Path $current 'network-idle.jsonl'
+            [IO.File]::WriteAllText($taskNetworkScenario,'')
+            $taskNetworkCount=[Math]::Min(4,$Ships)
+            foreach ($taskNetworkVariant in @('A','B')) {
+                Write-Host "Проверка $taskNetworkCount одновременных localhost-клиентов $taskNetworkVariant перед полной серией..."
+                & (Join-Path $PSScriptRoot 'native_replay.ps1') -Variant $taskNetworkVariant -Ships $taskNetworkCount -WarmupTicks 1800 -MeasuredTicks 600 -Scenario $taskNetworkScenario -OutputDirectory (Join-Path $current "network-preflight-$taskNetworkVariant") -ManifestPath $manifestPath -Seed $Seed -NetworkClients $taskNetworkCount -FunctionalOnly -KeepNativeNpcAwake
+            }
+        }
+        $warmup=10800
+        $measured=$Minutes*3600
+        if ($Legacy) { $warmup=7200; $measured=72000 }
+        Write-Host "A–B–B–A: $Ships кораблей, $($warmup/3600) мин прогрева + $($measured/3600) мин измерения на запуск."
+        Set-LauncherStage 5 'Серия A–B–B–A и проверка отчётов'
+        Write-Host 'Полное игровое покрытие учитывается отдельно от длительности серии.'
+        & (Join-Path $PSScriptRoot 'load_series.ps1') -OutputDirectory (Join-Path $current 'series') -ReplayRoot (Join-Path $current 'runs') -ManifestPath $manifestPath -Ships $Ships -WarmupTicks $warmup -MeasuredTicks $measured -Seed $Seed -Quick:$Quick -Legacy:$Legacy -FullGame:(-not $Legacy) -Diagnostic:$Diagnostic
+        if ($Diagnostic) {
+            $taskDiagnosticState=Get-Content -LiteralPath (Join-Path $current 'series/status.json') -Raw | ConvertFrom-Json
+            @{status=$taskDiagnosticState.status;benchmarkKind=$taskBenchmarkKind;strictReady=$false;fullGameplayCoverage=$false;completedUtc=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json | Set-Content (Join-Path $current 'launcher-status.json')
+            if ($taskDiagnosticState.status -ne 'DIAGNOSTIC_ABBA_COMPLETE') { $exitCode=1 }
+        } else {
+        @{status='ABBA_COMPLETE';benchmarkKind=$taskBenchmarkKind;fullGameplayCoverage=$false;completedUtc=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json | Set-Content (Join-Path $current 'launcher-status.json')
+        }
+        }
+    }
+} catch {
+    $exitCode=1
+    Write-Host "Ошибка: $($_.Exception.Message)" -ForegroundColor Red
+    if ($current) { @{status='FAILED_INCOMPLETE';error=$_.Exception.Message} | ConvertTo-Json | Set-Content (Join-Path $current 'launcher-status.json') }
+    if ($current) {
+        $taskStagePath=Join-Path $current 'launcher-stage.json'
+        if (Test-Path -LiteralPath $taskStagePath) {
+            $taskFailedStage=Get-Content -LiteralPath $taskStagePath -Raw | ConvertFrom-Json
+            Set-LauncherStage $taskFailedStage.stage $taskFailedStage.name 'FAILED_INCOMPLETE'
+        } else { Set-LauncherStage 1 'Подготовка запуска' 'FAILED_INCOMPLETE' }
+    }
+} finally {
+    if ($current) {
+        try {
+            if ($exitCode -eq 0) { Set-LauncherStage 6 'Подготовка архива результатов' }
+            if ($taskTranscript) { Stop-Transcript | Out-Null; $taskTranscript=$false }
+        } catch { $exitCode=1; Write-Host "Ошибка сохранения журнала/этапа: $($_.Exception.Message)" -ForegroundColor Red }
+        if ($Diagnostic -and (Test-Path -LiteralPath (Join-Path $current 'series/status.json'))) {
+            $taskFinalSeries=Get-Content -LiteralPath (Join-Path $current 'series/status.json') -Raw | ConvertFrom-Json
+            $taskFinalStageStatus=if ($exitCode -eq 0) {'COMPLETE'} elseif (@($taskFinalSeries.attemptedRuns).Count -eq 4) {'FINISHED_WITH_ERRORS'} else {'FAILED_INCOMPLETE'}
+            Set-LauncherStage 7 'Сохранение итогового архива; итог серии в launcher-status.json' $taskFinalStageStatus
+        }
+        & python (Join-Path $PSScriptRoot 'partial_archive.py') $current
+        if ($LASTEXITCODE -ne 0) {
+            $exitCode=1
+            @{status='FAILED_INCOMPLETE';error='Не удалось подготовить итоговый архив.'} | ConvertTo-Json | Set-Content (Join-Path $current 'launcher-status.json')
+        }
+        if ($exitCode -eq 0) { Set-LauncherStage 7 'Запуск завершён, архив готов' 'COMPLETE' }
+    }
+    Exit-KiasBenchmarkLease $taskBenchmarkLease
+}
+exit $exitCode
diff --git a/Tools/KiasBenchmark/room_previews.py b/Tools/KiasBenchmark/room_previews.py
new file mode 100644
index 0000000000..068feda2c2
--- /dev/null
+++ b/Tools/KiasBenchmark/room_previews.py
@@ -0,0 +1,63 @@
+"""Render exported server room geometry without changing the source map."""
+import argparse
+import json
+from pathlib import Path
+from PIL import Image, ImageDraw
+
+
+def render(source: Path):
+    data = json.loads(source.read_text(encoding="utf-8-sig"))
+    rooms = {room["Id"]: room for room in data["rooms"]}
+    cells = [cell for room in rooms.values() for cell in room["tiles"] + room["doors"]]
+    cells += [cell for scanner in data["scanners"] for cell in scanner.get("cells", [])]
+    geometry = data.get("geometry", {})
+    cells += geometry.get("floors", [])
+    xmin, xmax = min(c[0] for c in cells) - 2, max(c[0] for c in cells) + 2
+    ymin, ymax = min(c[1] for c in cells) - 2, max(c[1] for c in cells) + 2
+    scale = 16
+    output = source.parent / "previews"
+    output.mkdir(exist_ok=True)
+    recommendations = ["# Briar: рекомендации по размещению", "",
+                       "Авторская карта не изменялась. Геометрия взята из серверного экспорта.", ""]
+    for scanner in data["scanners"]:
+        image = Image.new("RGB", ((xmax - xmin + 1) * scale, (ymax - ymin + 1) * scale + 55), "#101820")
+        draw = ImageDraw.Draw(image)
+
+        def cell(position, color):
+            x, y = position
+            left, top = (x - xmin) * scale, (ymax - y) * scale + 55
+            draw.rectangle((left + 1, top + 1, left + scale - 1, top + scale - 1), fill=color)
+
+        for tile in geometry.get("floors", []):
+            cell(tile, "#303b46")
+        for tile in geometry.get("walls", []):
+            cell(tile, "#88939e")
+        for tile in geometry.get("doors", []):
+            cell(tile, "#d89032")
+        for room in rooms.values():
+            for tile in room["tiles"]:
+                cell(tile, "#303b46")
+        room = rooms.get(scanner["roomId"])
+        if room or scanner.get("cells"):
+            for tile in scanner.get("cells", room["tiles"] if room else []):
+                cell(tile, "#168ca3")
+            for tile in scanner.get("doors", room["doors"] if room else []):
+                cell(tile, "#d89032")
+        cell((scanner["x"], scanner["y"]), "#ef4a58")
+        draw.text((8, 8), f"Scanner {scanner['uid']} ({scanner['x']}, {scanner['y']}) rotation={scanner['rotation']}", fill="white")
+        draw.text((8, 25), f"{scanner['status']}; room={scanner['roomId']}; tiles={scanner['tileCount']}; doors={scanner['doorCount']}", fill="white")
+        image.save(output / f"scanner-{scanner['uid']}.png")
+        if scanner["status"] == "NoInteriorSeed":
+            recommendations.append(f"- UID {scanner['uid']}, ({scanner['x']}, {scanner['y']}), {scanner['rotation']}°: нет интерьерного seed. Проверить сторону стены и ориентацию; покрытие отключено.")
+        elif scanner["status"] == "OpenToSpace":
+            recommendations.append(f"- UID {scanner['uid']}, ({scanner['x']}, {scanner['y']}): область открыта в космос. Fallback: достижимые клетки грида в радиусе 7, без прохода через двери.")
+    uncovered = [room["Id"] for room in rooms.values() if not room["scanners"]]
+    recommendations += ["", f"Области без сканеров: {uncovered}. В список входят малые изолированные области; требуется оценка по превью."]
+    (source.parent / "BriarPlacementRecommendations.md").write_text("\n".join(recommendations) + "\n", encoding="utf-8")
+    return len(data["scanners"])
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("source", type=Path)
+    print(f"Rendered {render(parser.parse_args().source)} scanner previews")
diff --git a/Tools/KiasBenchmark/scaling_smoke_report.py b/Tools/KiasBenchmark/scaling_smoke_report.py
new file mode 100644
index 0000000000..b969fc707b
--- /dev/null
+++ b/Tools/KiasBenchmark/scaling_smoke_report.py
@@ -0,0 +1,46 @@
+"""Combine independently validated short fleet tiers without a performance claim."""
+import argparse
+import json
+from pathlib import Path
+
+from fullgame_report import smoke_report
+
+
+def report(directories, output):
+    rows = []
+    harnesses = set()
+    for directory in directories:
+        result = smoke_report(directory)
+        assert {run["variant"] for run in result["runs"]} == {"A", "B"}, "Each tier requires A and B"
+        assert len(result["runs"]) == 2 and {run["group"] for run in result["runs"]} == {"composite"}
+        for run in result["runs"]:
+            harnesses.add((run["fingerprints"]["nativeLabSha256"], run["fingerprints"]["nativeGameDriversSha256"]))
+            final = run["finalTelemetry"]
+            rows.append(dict(ships=run["ships"], variant=run["variant"],
+                             delivered=run["nativeProof"]["inputs"], nativeCompletions=run["nativeProof"]["nativeCompletions"],
+                             synchronousWaves=len(run["waves"]), runningCards=final["runningCards"] if final else None,
+                             commandLatency=final["acceptedCommandLatency"] if final else None,
+                             evidence=str(directory / "smoke-results.json")))
+    assert len(harnesses) == 1, "Asymmetric fleet-tier harnesses"
+    assert sorted(row["ships"] for row in rows if row["variant"] == "B") == [1, 10, 20, 40], "Missing fleet tier"
+    result = dict(status="FOUR_TIER_COMPOSITE_NATIVE_SMOKE_COMPLETE", performanceEligible=False,
+                  fullGameplayCoverage=False,
+                  scope="Composite wave tiers only; all other 40-ship event classes, hull diversity and performance acceptance remain separate requirements",
+                  runs=rows)
+    output.mkdir(parents=True, exist_ok=True)
+    (output / "scaling-smoke.json").write_text(json.dumps(result, indent=2), encoding="utf-8")
+    text = ["# Составная волна: 1/10/20/40 кораблей", "", "FULL GAME FINAL RUN NOT YET EXECUTED.", "",
+            "Проверены настоящие воздействия, их физическое завершение, одинаковый серверный тик старта и восстановление карточек/очередей.",
+            "Это короткие функциональные проверки, не приёмка производительности или всех классов событий на 40 кораблях.", "",
+            "| Корабли | Вариант | Доставлено | Асинхронных завершений | Работающие карточки |", "|---:|---|---:|---:|---:|"]
+    text.extend(f"| {row['ships']} | {row['variant']} | {row['delivered']} | {row['nativeCompletions']} | {row['runningCards'] if row['runningCards'] is not None else '—'} |" for row in rows)
+    (output / "ScalingSmoke.md").write_text("\n".join(text) + "\n", encoding="utf-8")
+    return result
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("directories", nargs=4, type=Path)
+    parser.add_argument("--output", type=Path, required=True)
+    options = parser.parse_args()
+    print(report(options.directories, options.output)["status"])
diff --git a/Tools/KiasBenchmark/scanner_ui.ps1 b/Tools/KiasBenchmark/scanner_ui.ps1
new file mode 100644
index 0000000000..cdb339ca31
