+            Spawn("KiasCore"); Spawn("KiasDataCable"); var rack = Spawn("KiasControllerRack");
+            scanner = Spawn("KiasRoomScanner"); card = Spawn("KiasProgrammableController");
+            em.System<KiasSystem>().Rebuild(map.Grid);
