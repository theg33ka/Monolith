@@ -0,0 +1,76 @@
+param(
+    [Parameter(Mandatory=$true)][string]$ManifestPath,
+    [Parameter(Mandatory=$true)][string]$OutputDirectory,
+    [ValidateSet('room_overlap','navigation_collision','collision_rotated','pdc_operator','deferred','composite','systems','pdc_controls','magazine','fanout','vent','fire','combat','collision','world','crew_power','gun')][string[]]$Groups=@('systems','vent','fire','combat','collision','world','composite','deferred','pdc_operator','collision_rotated','navigation_collision','room_overlap'),
+    [ValidateSet('A','B')][string[]]$Variants=@('A','B'),
+    [ValidateRange(1,40)][int]$Ships=1,
+    [int]$Seed=20261010,
+    [ValidateRange(0,4)][int]$NetworkClients=0
+)
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'benchmark_lock.ps1')
+$taskBenchmarkLease=Enter-KiasBenchmarkLease (Join-Path $PSScriptRoot '../..')
+try {
+    Test-KiasBenchmarkPorts
+$taskSuiteRoot=[IO.Path]::GetFullPath($OutputDirectory)
+if (Test-Path -LiteralPath $taskSuiteRoot) { throw 'Suite output already exists; refusing to overwrite.' }
+New-Item -ItemType Directory -Path $taskSuiteRoot | Out-Null
+Copy-Item -LiteralPath $ManifestPath -Destination (Join-Path $taskSuiteRoot 'baseline-manifest.json')
+$taskManifest=Get-Content -LiteralPath $ManifestPath -Raw | ConvertFrom-Json
+foreach ($taskBuild in ($taskManifest.builds | Where-Object { $_.label -in $Variants })) {
+    $taskFrozen=Join-Path $taskSuiteRoot "frozen-source/$($taskBuild.label)"
+    New-Item -ItemType Directory -Path $taskFrozen -Force | Out-Null
+    foreach ($taskFile in @('NativeLab.cs','NativeGameDrivers.cs','KiasTelemetry.cs')) {
+        $taskInput=Join-Path $taskBuild.source "Tools/KiasBenchmark/Server/$taskFile"
+        if (Test-Path -LiteralPath $taskInput) { Copy-Item -LiteralPath $taskInput -Destination $taskFrozen }
+    }
+}
+$taskResults=@()
+$taskClock=[Diagnostics.Stopwatch]::StartNew()
+foreach ($taskGroup in $Groups) {
+    $taskScenario=Join-Path $taskSuiteRoot "$taskGroup.jsonl"
+    $taskScenarioSummary=& python (Join-Path $PSScriptRoot 'world_smoke_scenario.py') --ships $Ships --group $taskGroup --output $taskScenario | ConvertFrom-Json
+    if ($LASTEXITCODE -ne 0) { throw "Scenario generation failed: $taskGroup" }
+    if ($taskScenarioSummary.measuredTicks -le 0 -or $taskScenarioSummary.events -le 0) { throw "Invalid scenario duration or event count: $taskGroup" }
+    foreach ($taskVariant in $Variants) {
+        $taskRun=Join-Path $taskSuiteRoot "$taskGroup-$taskVariant"
+        $taskStarted=$taskClock.Elapsed.TotalSeconds
+        $taskError=$null
+        Write-Host "Native smoke $($taskResults.Count+1)/$($Groups.Count*$Variants.Count): $taskGroup $taskVariant"
+        try {
+            & (Join-Path $PSScriptRoot 'native_replay.ps1') -Variant $taskVariant -Ships $Ships -WarmupTicks 1800 -MeasuredTicks $taskScenarioSummary.measuredTicks -Scenario $taskScenario -FunctionalOnly -KeepNativeNpcAwake -ManifestPath $ManifestPath -OutputDirectory $taskRun -Seed $Seed -NetworkClients $NetworkClients *>&1 | Tee-Object -FilePath (Join-Path $taskSuiteRoot "$taskGroup-$taskVariant.log")
+            if (-not (Test-Path -LiteralPath (Join-Path $taskRun 'completed.json'))) { throw 'Missing completed native postconditions.' }
+            & python (Join-Path $PSScriptRoot 'native_proof.py') $taskRun $taskScenario *> (Join-Path $taskSuiteRoot "$taskGroup-$taskVariant-proof.json")
+            if ($LASTEXITCODE -ne 0) { throw 'Native dispatch/completion proof failed integrity validation.' }
+            if ($taskGroup -eq 'room_overlap' -and $taskVariant -eq 'B') {
+                $taskRoomProof=Get-Content (Join-Path $taskSuiteRoot "$taskGroup-$taskVariant-proof.json") -Raw | ConvertFrom-Json
+                if ($taskRoomProof.doorsObservedDuringBreach -le 0) { throw 'Room regression did not observe native doors during a real breach.' }
+                if ($Ships -ge 10 -and $taskRoomProof.roomObservationsStartedPending -le 0) { throw 'Room regression did not exercise pending topology.' }
+            }
+            if ($NetworkClients -gt 0) {
+                & python (Join-Path $PSScriptRoot 'network_proof.py') $taskRun *> (Join-Path $taskSuiteRoot "$taskGroup-$taskVariant-network.json")
+                if ($LASTEXITCODE -ne 0) { throw 'Native smoke real-client proof failed.' }
+            }
+        } catch { $taskError=$_.Exception.Message }
+        $taskResults+=@{group=$taskGroup;variant=$taskVariant;status=$(if ($taskError) {'FAIL'} else {'PASS'});error=$taskError;wallSeconds=$taskClock.Elapsed.TotalSeconds-$taskStarted;path=$taskRun}
+        @{scope='ISOLATED_NATIVE_SMOKE; not full-game certification';results=$taskResults} | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $taskSuiteRoot 'suite-status.tmp') -Encoding UTF8
+        Move-Item -LiteralPath (Join-Path $taskSuiteRoot 'suite-status.tmp') -Destination (Join-Path $taskSuiteRoot 'suite-status.json') -Force
+        Write-Host "$taskGroup $taskVariant : $($taskResults[-1].status)"
+    }
+}
+$taskReportError=$null
+try {
+    if (-not @($taskResults | Where-Object status -ne 'PASS').Count) {
+        & python (Join-Path $PSScriptRoot 'fullgame_report.py') $taskSuiteRoot --smoke
+        if ($LASTEXITCODE -ne 0) { throw 'Native smoke report failed integrity validation.' }
+    }
+} catch {
+    $taskReportError=$_.Exception.Message
+    @{status='FAILED_INCOMPLETE';error=$taskReportError} | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $taskSuiteRoot 'report-status.json') -Encoding utf8
+}
+& python (Join-Path $PSScriptRoot 'partial_archive.py') $taskSuiteRoot
+if ($LASTEXITCODE -ne 0) { throw 'Native smoke archive failed.' }
+if ($taskReportError) { throw $taskReportError }
+if (@($taskResults | Where-Object status -ne 'PASS').Count) { throw "Native smoke contains failures: $taskSuiteRoot/suite-status.json" }
+
+} finally { Exit-KiasBenchmarkLease $taskBenchmarkLease }
diff --git a/Tools/KiasBenchmark/network_proof.py b/Tools/KiasBenchmark/network_proof.py
new file mode 100644
index 0000000000..7b07d9fc61
--- /dev/null
+++ b/Tools/KiasBenchmark/network_proof.py
@@ -0,0 +1,89 @@
+"""Verify real client attachment and measured network/serialization activity."""
+import argparse
+import json
+import math
+import re
+from pathlib import Path
+
+from native_proof import read
+
+
+def metric(text, name, labels=""):
+    found = re.findall(r"^" + re.escape(name + labels) + r"\s+(\S+)\s*$", text, re.M)
+    assert len(found) == 1, f"Missing or ambiguous metric: {name}{labels}"
+    value = float(found[0])
+    assert math.isfinite(value) and value >= 0, f"Invalid metric: {name}"
+    return value
+
+
+def continuity(history, expected):
+    """Validate observed session continuity; this does not certify game completion."""
+    assert history and [row["checks"] for row in history] == list(range(1,len(history)+1)), "Network history missing checks"
+    first = next((index for index,row in enumerate(history) if row["admitted"]), None)
+    assert first is not None, "Four clients were never admitted"
+    admitted = history[first:]
+    assert all(row["admitted"] for row in admitted), "Admission was reset after clients joined"
+    for row in admitted:
+        assert row["connected"] == row["required"] == expected, "Client lost after admission"
+        assert len(row["bindings"]) == expected and all(item["connected"] and item["status"] == "InGame" for item in row["bindings"]), "Session not InGame throughout soak"
+    assert all(right["engineTick"]-left["engineTick"]==60 for left,right in zip(history,history[1:])), "Missing periodic network observations"
+    durations=[row['admissionElapsedSeconds'] for row in admitted]
+    assert all(math.isfinite(value) and value>=0 for value in durations) and durations==sorted(durations), 'Invalid admission clock'
+    seconds=durations[-1]
+    return dict(checks=len(history),admittedChecks=len(admitted),continuousClients=expected,wallSeconds=seconds,
+                    exceedsOriginalGuestAfkTimeout=seconds>25*60,observationIntervalTicks=60)
+
+
+def validate(directory):
+    manifest = read(directory / "run-manifest.json")
+    started, completed = read(directory / "started.json"), read(directory / "completed.json")
+    assert completed["status"] == "PARTIAL_NATIVE_DRY_RUN_COMPLETE", "Network run incomplete"
+    assert completed["measuredTicks"] == started["measuredTicks"] > 0, "Network measurement incomplete"
+    assert completed["ships"] == started["ships"] > 0, "Network fleet mismatch"
+    assert manifest["clientSandboxEnabled"] is True, "Client sandbox disabled"
+    assert not any((directory / name).exists() for name in ("failed.json", "run-failed.json")), "Network run marked failed"
+    for name in ("server.log", "server-error.log"):
+        log = (directory / name).read_text(encoding="utf-8-sig", errors="replace")
+        assert "[ERRO]" not in log and "[FATL]" not in log, "Server errors invalidate network proof"
+    expected = manifest["networkClients"]
+    assert expected > 0, "No real network clients requested"
+    sessions = read(directory / "network-sessions.json")
+    assert sessions["required"] == sessions["connected"] == expected, "Missing real client attachment"
+    bindings = sessions["bindings"]
+    assert len(bindings) == len({item["user"] for item in bindings}) == expected, "Duplicate real session"
+    assert len({item["ConnectionId"] for item in bindings}) == expected, "Duplicate network channel"
+    assert all(item["connected"] and item["status"] == "InGame" for item in bindings), "Disconnected client"
+    warnings = {}
+    for item in bindings:
+        for suffix in (".log", "-error.log"):
+            log = (directory / (item["name"] + suffix)).read_text(encoding="utf-8-sig", errors="replace")
+            assert "[ERRO]" not in log and "[FATL]" not in log, "Client errors invalidate network proof"
+            warnings[item["name"] + suffix] = dict(warnings=log.count("[WARN]"), droppedSendWarnings=log.count("via Lidgren: Dropped"))
+    before = (directory / "metrics-0.prom").read_text(encoding="utf-8-sig")
+    after = (directory / "metrics-final.prom").read_text(encoding="utf-8-sig")
+    deltas = {}
+    for name in ("robust_net_sent_bytes", "robust_net_recv_bytes", "robust_net_sent_messages", "robust_net_recv_messages"):
+        deltas[name] = metric(after, name) - metric(before, name)
+        assert deltas[name] > 0, f"No measured traffic: {name}"
+    for field in ("sum", "count"):
+        name = "robust_game_state_update_usage_" + field
+        labels = '{area="Serialize States"}'
+        deltas["serializeStates_" + field] = metric(after, name, labels) - metric(before, name, labels)
+        assert deltas["serializeStates_" + field] > 0, "No measured native state serialization"
+    for name in ("robust_net_dropped", "robust_net_resent_delay", "robust_net_resent_hole"):
+        deltas[name] = metric(after, name) - metric(before, name)
+        assert deltas[name] >= 0, f"Network counter reset: {name}"
+    continuous = None
+    if manifest.get("networkHistoryRequired"):
+        history = [json.loads(line) for line in (directory / "network-session-history.jsonl").read_text(encoding="utf-8-sig").splitlines() if line.strip()]
+        continuous = continuity(history, expected)
+    return dict(status="PASS", clients=expected, measuredTicks=completed["measuredTicks"],continuousAdmission=continuous,
+                performanceEligible=manifest["performanceEligible"], measuredDeltas=deltas, bindings=bindings,
+                clientWarnings=warnings,
+                scope="Real session attachment, traffic and state serialization; no automated client input workload")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("directory", type=Path)
+    print(json.dumps(validate(parser.parse_args().directory), indent=2))
diff --git a/Tools/KiasBenchmark/optimization_compare.ps1 b/Tools/KiasBenchmark/optimization_compare.ps1
new file mode 100644
index 0000000000..dddd5f7365
--- /dev/null
+++ b/Tools/KiasBenchmark/optimization_compare.ps1
@@ -0,0 +1,57 @@
+param([Parameter(Mandatory)][string]$BeforeManifest,[Parameter(Mandatory)][string]$AfterManifest,
+    [Parameter(Mandatory)][string]$ScenarioDirectory,[Parameter(Mandatory)][string]$OutputDirectory,
+    [ValidateRange(3,10)][int]$Replicates=3)
+$ErrorActionPreference='Stop'
+. (Join-Path $PSScriptRoot 'benchmark_lock.ps1')
+$lease=Enter-KiasBenchmarkLease (Join-Path $PSScriptRoot '../..')
+$root=[IO.Path]::GetFullPath($OutputDirectory)
+if(Test-Path -LiteralPath $root){Exit-KiasBenchmarkLease $lease;throw 'Refusing to overwrite optimization evidence'}
+New-Item -ItemType Directory -Path $root | Out-Null
+$before=Get-Content $BeforeManifest -Raw | ConvertFrom-Json
+$after=Get-Content $AfterManifest -Raw | ConvertFrom-Json
+$state=@{status='OPTIMIZATION_RUNNING';completedRuns=@();strictReady=$false;beforeFingerprint=$before.sourceFingerprint;afterFingerprint=$after.sourceFingerprint}
+function Save-OptimizationState {
+    $state | ConvertTo-Json -Depth 10 | Set-Content (Join-Path $root 'optimization-status.tmp') -Encoding utf8
+    Move-Item (Join-Path $root 'optimization-status.tmp') (Join-Path $root 'optimization-status.json') -Force
+}
+function Invoke-OptimizationRun([string]$Regime,[int]$Replicate,[string]$Probe){
+    $current=& python (Join-Path $PSScriptRoot 'source_fingerprint.py') | ConvertFrom-Json
+    if($LASTEXITCODE -ne 0 -or $current.sha256 -ne $after.sourceFingerprint){throw 'Optimization sources changed'}
+    $manifest=if($Probe -eq 'BEFORE'){$BeforeManifest}else{$AfterManifest}
+    $ablation=if($Probe -in @('BEFORE','AFTER')){'None'}else{$Probe}
+    $scenario=Join-Path $root "40-$Regime.jsonl"
+    $run=Join-Path $root "runs/$Regime-$Replicate-$Probe"
+    & (Join-Path $PSScriptRoot 'native_replay.ps1') -Variant B -Ships 40 -WarmupTicks 1800 -MeasuredTicks 1800 -Scenario $scenario -OutputDirectory $run -ManifestPath $manifest -Seed 20261010 -Profile -NetworkClients 4 -KeepNativeNpcAwake -DisablePhysicsQueryCounters -Ablation $ablation
+    & python (Join-Path $PSScriptRoot 'native_proof.py') $run $scenario *> (Join-Path $run 'native-proof.json')
+    if($LASTEXITCODE -ne 0){throw "Optimization native proof failed $run"}
+    $state.completedRuns+=@{regime=$Regime;replicate=$Replicate;probe=$Probe;path=$run}
+    Save-OptimizationState
+}
+try {
+    Test-KiasBenchmarkPorts
+    if($before.engine -ne $after.engine -or $before.staticParity.bMapSha256 -ne $after.staticParity.bMapSha256){throw 'Optimization engine/map parity mismatch'}
+    Copy-Item $BeforeManifest (Join-Path $root 'BEFORE_MANIFEST.json')
+    Copy-Item $AfterManifest (Join-Path $root 'AFTER_MANIFEST.json')
+    foreach($regime in @('IDLE','MIXED')){
+        Copy-Item (Join-Path $ScenarioDirectory "40-$regime.jsonl") (Join-Path $root "40-$regime.jsonl")
+        foreach($replicate in 1..$Replicates){
+            $order=if($replicate%2){@('BEFORE','AFTER')}else{@('AFTER','BEFORE')}
+            foreach($probe in $order){Invoke-OptimizationRun $regime $replicate $probe}
+        }
+    }
+    foreach($replicate in 1..$Replicates){
+        $probes=if($replicate%2){@('CrewFilterOff','CoveragePassOff','RuntimeIdleOff')}else{@('RuntimeIdleOff','CoveragePassOff','CrewFilterOff')}
+        foreach($probe in $probes){Invoke-OptimizationRun 'IDLE' $replicate $probe}
+    }
+    $state.status='OPTIMIZATION_SAMPLES_COMPLETE';Save-OptimizationState
+    & python (Join-Path $PSScriptRoot 'optimization_report.py') $root
+    if($LASTEXITCODE -ne 0){throw 'Optimization accounting failed'}
+} catch {
+    $state.status='FAILED_INCOMPLETE';$state.error=$_.Exception.Message;Save-OptimizationState
+    throw
+} finally {
+    try {
+        & python (Join-Path $PSScriptRoot 'partial_archive.py') $root
+        if($LASTEXITCODE -ne 0){throw "Optimization archive failed: $root"}
+    } finally {Exit-KiasBenchmarkLease $lease}
+}
diff --git a/Tools/KiasBenchmark/optimization_report.py b/Tools/KiasBenchmark/optimization_report.py
new file mode 100644
index 0000000000..8ef0d11074
--- /dev/null
+++ b/Tools/KiasBenchmark/optimization_report.py
@@ -0,0 +1,38 @@
+"""Counterbalanced before/after and individual restoration probes, without acceptance waivers."""
+import json
+from pathlib import Path
+import statistics
+from cost_attribution import read_run, block_interval, GROUPS
+
+
+def report(root):
+    root=Path(root)
+    state=json.loads((root/"optimization-status.json").read_text(encoding="utf-8-sig"))
+    assert state["status"]=="OPTIMIZATION_SAMPLES_COMPLETE"
+    runs=[dict(item,measurement=read_run(item["path"])) for item in state["completedRuns"]]
+    comparisons=[]
+    for regime in ("IDLE","MIXED"):
+        for probe in ("BEFORE","CrewFilterOff","CoveragePassOff","RuntimeIdleOff"):
+            left=[r["measurement"] for r in runs if r["regime"]==regime and r["probe"]==probe]
+            right=[r["measurement"] for r in runs if r["regime"]==regime and r["probe"]=="AFTER"]
+            if not left: continue
+            assert len(left)>=3 and len(right)>=3,"At least three repetitions required"
+            mean=lambda values,key:statistics.mean(r["whole"][key] for r in values)
+            comparisons.append(dict(regime=regime,restored=probe,leftRuns=len(left),afterRuns=len(right),
+                savedMeanMs=mean(left,"meanMs")-mean(right,"meanMs"),savedP50Ms=mean(left,"p50Ms")-mean(right,"p50Ms"),
+                savedMeanBlock95Ci=block_interval([v for r in right for v in r["rawWhole"]],[v for r in left for v in r["rawWhole"]]),
+                exclusiveSavedMeanMs={group:statistics.mean(r["groups"][group]["meanMs"] for r in left)-statistics.mean(r["groups"][group]["meanMs"] for r in right) for group in GROUPS}))
+    for run in runs:
+        run["measurement"].pop("rawWhole");run["measurement"].pop("rawGroups")
+    result=dict(status="MEASURED_NOT_GAMEPLAY_CERTIFICATION",comparisons=comparisons,runs=runs,
+        caveat="Positive savings favor optimized B. Individual probes restore one old algorithm with other patches enabled; interactions mean individual effects cannot be summed. Whole p50 differences are separate from additive exclusive means. Before and after use identical 40-ship scenarios, four real clients and the same engine; test-only switches add small branch overhead only to AFTER builds. Confidence intervals crossing zero do not establish a whole-tick gain.")
+    (root/"optimization-comparison.json").write_text(json.dumps(result,indent=2),encoding="utf-8")
+    lines=["# B before / B after","",result["caveat"],"","| Regime | Restored old algorithm | Saved mean ms | Saved p50 ms | Mean 95% block CI |","|---|---|---:|---:|---|"]
+    for c in comparisons:lines.append(f"| {c['regime']} | {c['restored']} | {c['savedMeanMs']:.6f} | {c['savedP50Ms']:.6f} | {c['savedMeanBlock95Ci']} |")
+    (root/"OPTIMIZATION_COMPARISON.md").write_text("\n".join(lines)+"\n",encoding="utf-8")
+    return result
+
+
+if __name__=="__main__":
+    import sys
+    report(sys.argv[1])
diff --git a/Tools/KiasBenchmark/package_analysis.py b/Tools/KiasBenchmark/package_analysis.py
new file mode 100644
index 0000000000..8c6e2b61f8
--- /dev/null
+++ b/Tools/KiasBenchmark/package_analysis.py
@@ -0,0 +1,117 @@
+"""Package recorded runs without game databases or generated performance data."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import zipfile
+
+
+def package(series, destination):
+    series = series.resolve()
+    repo = Path(__file__).resolve().parents[2]
+    state = json.loads((series / 'status.json').read_text(encoding='utf-8-sig'))
+    files = {}
+
+    def add(path, name):
+        if path.is_file():
+            files[name] = path
+
+    for path in series.iterdir():
+        add(path, 'series/' + path.name)
+    for path in (series.parent / 'preflight').rglob('*'):
+        if 'data' not in path.relative_to(series.parent / 'preflight').parts:
+            add(path, 'preflight/' + path.relative_to(series.parent / 'preflight').as_posix())
+    runs = list(state.get('completedRuns', []))
+    for path in sorted((series.parent / 'runs').glob('*')):
+        if path.is_dir() and not any(Path(run['path']).resolve() == path.resolve() for run in runs):
+            runs.append({'path': str(path)})
+    for run in runs:
+        folder = Path(run['path'])
+        for path in folder.iterdir():
+            add(path, 'runs/' + folder.name + '/' + path.name)
+    for directory in ('Tools/KiasBenchmark', 'Content.Server/_Forge/KIAS',
+                      'Content.Shared/_Forge/KIAS', 'Content.IntegrationTests/Tests/_Forge/KIAS'):
+        for path in (repo / directory).rglob('*'):
+            if path.suffix in ('.cs', '.py', '.ps1', '.md'):
+                add(path, 'sources/' + path.relative_to(repo).as_posix())
+    for path in (repo/'Docs/KIAS/History').glob('0*.md'):
+        add(path, 'specification/' + path.name)
+    for name in ('Tools/KiasBenchmark/RUNBOOK.md', 'Resources/Prototypes/_Forge/KIAS/controller_presets.yml',
+                 'Resources/Maps/_Forge/KIAS/Fixtures/briarKIAS.yml',
+                 'Resources/Prototypes/Entities/Structures/Specific/Anomaly/anomalies.yml'):
+        add(repo / name, 'sources/' + name)
+    for path in (series.parent / 'tests').glob('*'):
+        add(path, 'functional-tests/' + path.name)
+    add(series.parent / 'functional-gate.log', 'functional-tests/gate.log')
+    for path in (series.parent / 'functional').rglob('*'):
+        add(path, 'functional-tests/physical/' + path.relative_to(series.parent / 'functional').as_posix())
+    for name in ('flesh-kias.trx', 'flesh-anomaly.trx'):
+        add(repo / '.kias-benchmark/tests' / name, 'prior-functional-tests/' + name)
+    for path in (repo / '.kias-benchmark/flesh-physical').glob('*'):
+        add(path, 'prior-functional-tests/physical/' + path.name)
+    guide = f'''# KIAS: данные для анализа
+
+Статус данной серии: {state['status']}.
+Ожидаемый порядок A–B–B–A, {state['ships']} кораблей, 60 TPS, каждый прогон:
+{state['warmupTicks']} тиков прогрева + {state['measuredTicksPerRun']} тиков измерения. A — база, B — KIAS.
+Если статус FAILED_INCOMPLETE, архив содержит только доступные данные;
+это не законченная серия и не основание для объявления PASS.
+
+Начните с series/status.json, results.json и report.html (последние два
+есть только после успешной проверки серии). Исходные данные в runs:
+ticks.csv, events.jsonl, progress.jsonl, manifests, server logs и Prometheus.
+В HTML ссылки на локальные исходники могут вести к машине автора;
+используйте соответствующие файлы в runs. SHA256SUMS.txt проверяет архив.
+
+Сравните A1/B1 и A2/B2 отдельно, затем фазы IDLE/MIXED/BURST/RECOVERY.
+Смотрите p99/p99.9, тики сверх 16.667 мс, аллокации, GC, CPU и память.
+Не удаляйте выбросы. Последовательные тики не являются независимыми
+повторами опыта. TickStart/Stop не включает frame input/update вне Tick.
+Гистограммы Update включают синхронные обработчики, это не профиль методов.
+Минутные очереди не доказывают максимальный backlog. Интервалы Prometheus
+отличаются от точного интервала 72000 тиков.
+
+Аномалия — AnomalyFlesh с явным прототипом и проверкой опасных компонентов;
+в нагрузке удаляется до первого импульса, сохраняет штатную смену тайлов.
+При просадке Running проверьте activeMachines, Fault, dirty topology,
+восстановление за 120 тиков и recoveredSameMachines.
+
+Покрытие ограничено семью парами драйверов. Нет FTL, стыковки, стрельбы,
+столкновений и разрыва DATA. Экипаж нагрузки без зарегистрированных KIAS
+транспондеров не доказывает исполнение CrewCritical. Полное равенство миров
+и причинные задержки до действий не доказаны. Полный benchmark PASS
+по этой серии объявлять нельзя.
+
+prior-functional-tests — прошлые проверки, они не запускаются повторно
+батником и не подтверждают автоматически последующие изменения кода.
+sources — код на момент упаковки; манифесты фиксируют измеренные сборки.
+
+Задача агенту: проверить целостность и сравнимость, выделить добавочную
+нагрузку систем, сопоставить с кодом, отделить доказательства от гипотез,
+предложить приоритеты оптимизации и дополнительные замеры.
+'''
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = destination.with_suffix('.zip.tmp')
+    try:
+        with zipfile.ZipFile(temporary, 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
+            archive.writestr('README.md', guide)
+            for name, path in sorted(files.items()):
+                archive.write(path, name)
+            archive.writestr('SHA256SUMS.txt', ''.join(
+                hashlib.sha256(path.read_bytes()).hexdigest() + '  ' + name + '\n'
+                for name, path in sorted(files.items())))
+        with zipfile.ZipFile(temporary) as archive:
+            if archive.testzip() is not None:
+                raise ValueError('Archive integrity check failed.')
+        temporary.replace(destination)
+    finally:
+        temporary.unlink(missing_ok=True)
+    return destination
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('series', type=Path)
+    parser.add_argument('destination', type=Path)
+    args = parser.parse_args()
+    print(package(args.series, args.destination))
diff --git a/Tools/KiasBenchmark/partial_archive.py b/Tools/KiasBenchmark/partial_archive.py
new file mode 100644
index 0000000000..5908b674be
--- /dev/null
+++ b/Tools/KiasBenchmark/partial_archive.py
@@ -0,0 +1,38 @@
+"""Package evidence even when preparation or a native server fails early."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import zipfile
+
+
+def package(run: Path):
+    run = run.resolve()
+    output = run / "KIAS_web-agent.zip"
+    temporary = output.with_suffix(".zip.tmp")
+    excluded = {"builds", "obj", "bin", ".git", "data", "__pycache__"}
+    hashes = {}
+    with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED, compresslevel=3) as archive:
+        for directory, names, files in __import__("os").walk(run):
+            names[:] = [name for name in names if name not in excluded]
+            for name in files:
+                path = Path(directory) / name
+                if path in (output, temporary) or path.suffix.lower() in (".dll", ".pdb", ".exe"):
+                    continue
+                relative = path.relative_to(run).as_posix()
+                archive.write(path, relative)
+                hashes[relative] = hashlib.sha256(path.read_bytes()).hexdigest()
+        archive.writestr("ANALYSIS_README.txt",
+            "Inspect launcher-status.json and native failed.json/run-failed.json first. "
+            "An archive is preserved evidence, not a PASS. FULL GAME FINAL RUN NOT YET EXECUTED "
+            "unless an explicit validated FullGame completion report is present.\n")
+        archive.writestr("ARCHIVE_SHA256.json", json.dumps(hashes, indent=2, sort_keys=True))
+    temporary.replace(output)
+    print(f"Analysis archive: {output}")
+    return output
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("run", type=Path)
+    package(parser.parse_args().run)
