+            on = em.GetComponent<PoweredLightComponent>(lamp).On;
+            Assert.That(on, Is.False);
+            Assert.That(actuators.Suppress(suppression), Is.False);
+            Assert.That(slot.Contains(cartridge), Is.True);
+        });
