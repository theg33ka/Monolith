+                new() { Edit = action, Text = text, Revision = revision ?? draft.DraftRevision });
+            Assert.That(Edit(KiasGraphEdit.Rename, "Written program"), Is.True);
+            Assert.That(stored.Program.Name, Is.EqualTo("Controller"));
