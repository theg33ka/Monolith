+param([Parameter(Mandatory)][string]$ManifestPath,[Parameter(Mandatory)][string]$OutputDirectory,[int]$Seed=20261010)
+$ErrorActionPreference='Stop'
+$taskOutput=[IO.Path]::GetFullPath($OutputDirectory)
