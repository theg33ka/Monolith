+        [IO.Path]::GetFileName($taskResolved) -notmatch '^kias-log-watch-[0-9a-f]{32}$') {
+        throw 'Refusing cleanup outside the temporary log test directory'
+    }
+    Remove-Item -LiteralPath $taskRoot -Recurse -Force
+}
