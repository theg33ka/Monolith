+    public void Reconcile(EntityUid rack)
+    {
+        if (!TerminatingOrDeleted(rack) && Transform(rack).GridUid is { } grid && _kias.TopologyPending(grid)) return;
+        if (!_kias.IsOnline(rack)) { StopRack(rack); return; }
