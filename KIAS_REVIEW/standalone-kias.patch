+    public static readonly bool DisableRuntimeIdleFastPath = Environment.GetEnvironmentVariable("NATIVE_LAB_ABLATION") == "RuntimeIdleOff";
+    private const int ProfilePhaseBase = 1024, ProfileDriver = 1088, ProfileObserver = 1089, ProfileSlots = 1090;
+    private struct ProfileValue { public long Calls, Inclusive, Exclusive, Bytes; }
+    private static readonly Dictionary<string, int> ProfileSystems = new();
+    private static readonly string[] ProfileSystemNames = new string[ProfilePhaseBase];
+    public static string[] ProfilePhaseNames = Array.Empty<string>();
+    public static Func<object>? ProfilePhaseTotals;
+    private static object? _profileWarmPhases;
+    private static ProfileValue[]? _profileValues;
+    private static readonly Dictionary<string, string> ProfileJsonWrites = new();
+    private static readonly List<(string Name, string Line)> ProfileProgressLines = new();
+    private static bool _profileFlushStreams;
+    private static int _profileTick = -1, _profileSystem = -1;
+    private static long _profilePhaseTicks, _profilePhaseBytes, _profileSystemPhaseTicks, _profileSystemPhaseBytes;
+    private static bool ProfileEnabled => Environment.GetEnvironmentVariable("NATIVE_LAB_PROFILE") == "1";
+
+    private static void InitializeProfile()
+    {
+        if (!ProfileEnabled) return;
+        if (_duration > 7200) throw new InvalidOperationException("Per-system profiling is limited to 7200 ticks; long ABBA uses bounded normal telemetry.");
+        ProfileSystems.Clear(); Array.Clear(ProfileSystemNames);
+        ProfileJsonWrites.Clear(); ProfileProgressLines.Clear(); _profileFlushStreams = false;
+        _profileTick = -1; _profileSystem = -1;
+        _profileValues = new ProfileValue[checked((int) _duration * ProfileSlots)];
+        var manager = typeof(EntitySystemManager);
+        (manager.GetField("DiagnosticSystemFailure", BindingFlags.Static | BindingFlags.Public)
+            ?? throw new InvalidOperationException("Missing isolated engine failure hook.")).SetValue(null, (Action<Exception>) RecordFailure);
+        if (Environment.GetEnvironmentVariable("NATIVE_LAB_SYSTEM_COUNTERS") != "0")
+        {
+            (manager.GetField("DiagnosticBeforeSystem", BindingFlags.Static | BindingFlags.Public)
+                ?? throw new InvalidOperationException("Missing isolated engine system profiler hook.")).SetValue(null, (Action<string>) ProfileBeforeSystem);
+            (manager.GetField("DiagnosticAfterSystem", BindingFlags.Static | BindingFlags.Public)
+                ?? throw new InvalidOperationException("Missing isolated engine system profiler hook.")).SetValue(null, (Action<string, long, long>) ProfileAfterSystem);
+        }
+        AtomicJson("profile-config.json", new { enabled = true,
+            phaseCounters = Environment.GetEnvironmentVariable("NATIVE_LAB_PHASE_COUNTERS") != "0",
+            systemCounters = Environment.GetEnvironmentVariable("NATIVE_LAB_SYSTEM_COUNTERS") != "0",
+            scope = "Inclusive and exclusive elapsed wall scopes on the server thread, including preemption and GC; nested KIAS scopes subtracted from containing systems/native drivers. Process CPU is sampled separately. Instrument overhead requires ON/OFF calibration. CSV serialization occurs after measurement.",
+            stopwatchFrequency = Stopwatch.Frequency, fixedSlots = ProfileSlots });
+    }
+
+    private static void ProfileBeginTick(uint tick)
+    {
+        if (_profileValues == null) return;
+        if (tick == 0) _profileWarmPhases = ProfilePhaseTotals?.Invoke();
+        _profileTick = (int) tick; _profilePhaseTicks = 0; _profilePhaseBytes = 0; _profileSystem = -1;
+    }
+
+    private static void ProfileEndTick() => _profileTick = -1;
+
+    private static bool DeferProfileJson(string name, object value)
+    {
+        if (!ProfileEnabled || _profileTick < 0) return false;
+        ProfileJsonWrites[name] = JsonSerializer.Serialize(value);
+        return true;
+    }
+
+    private static void AppendProgressLine(string line)
+    {
+        AppendLabLine("progress.jsonl", line);
+    }
+
+    private static void AppendLabLine(string name, string line)
+    {
+        if (ProfileEnabled && _profileTick >= 0) ProfileProgressLines.Add((name, line));
+        else File.AppendAllText(Path.Combine(_output, name), line + Environment.NewLine);
+    }
+
+    private static void FlushProfileOutput()
+    {
+        if (!ProfileEnabled) return;
+        foreach (var (name, json) in ProfileJsonWrites)
+        {
+            if (name == "progress.json") { _pendingProgressJson = json; continue; }
+            var path = Path.Combine(_output, name);
+            File.WriteAllText(path + ".tmp", json);
+            File.Move(path + ".tmp", path, true);
+        }
+        ProfileJsonWrites.Clear();
+        FlushPendingProgress(force: true);
+        if (ProfileProgressLines.Count > 0)
+        {
+            foreach (var (name, line) in ProfileProgressLines)
+                File.AppendAllText(Path.Combine(_output, name), line + Environment.NewLine);
+            ProfileProgressLines.Clear();
+        }
+        if (_profileFlushStreams)
+        {
+            _events?.Flush(); _outcomes?.Flush(); _networkHistory?.Flush(); _profileFlushStreams = false;
+        }
+    }
+
+    private static void ProfileBeforeSystem(string name)
+    {
+        if (!ProfileSystems.TryGetValue(name, out var index))
+        {
+            index = ProfileSystems.Count;
+            if (index >= ProfilePhaseBase) throw new InvalidOperationException("Too many profiled entity systems.");
+            ProfileSystems.Add(name, index); ProfileSystemNames[index] = name;
+        }
+        _profileSystem = index;
+        _profileSystemPhaseTicks = _profilePhaseTicks;
+        _profileSystemPhaseBytes = _profilePhaseBytes;
+    }
+
+    private static void ProfileAfterSystem(string name, long ticks, long bytes)
+    {
+        if (_profileTick >= 0 && _profileSystem >= 0)
+            ProfileRecord(_profileSystem, ticks, ticks - (_profilePhaseTicks - _profileSystemPhaseTicks),
+                bytes - (_profilePhaseBytes - _profileSystemPhaseBytes));
+        _profileSystem = -1;
+    }
+
+    public static void ProfilePhaseObserved(int phase, long inclusive, long exclusive, long bytes, long exclusiveBytes)
+    {
+        if (_profileValues == null || _profileTick < 0) return;
+        if (phase < 0 || phase >= ProfileDriver - ProfilePhaseBase) throw new InvalidOperationException("Too many profiled KIAS phases.");
+        ProfileRecord(ProfilePhaseBase + phase, inclusive, exclusive, exclusiveBytes);
+        _profilePhaseTicks += exclusive; _profilePhaseBytes += exclusiveBytes;
+    }
+
+    private static (long Ticks, long Bytes) ProfileNativeStart() => (_profilePhaseTicks, _profilePhaseBytes);
+
+    private static void ProfileNativeEnd(bool observer, double milliseconds, long bytes, (long Ticks, long Bytes) before)
+    {
+        if (_profileValues == null || _profileTick < 0) return;
+        var ticks = (long) Math.Round(milliseconds * Stopwatch.Frequency / 1000d);
+        ProfileRecord(observer ? ProfileObserver : ProfileDriver, ticks,
+            ticks - (_profilePhaseTicks - before.Ticks), bytes - (_profilePhaseBytes - before.Bytes));
+    }
+
+    private static void ProfileRecord(int slot, long inclusive, long exclusive, long bytes)
+    {
+        if (exclusive < 0 || bytes < 0) throw new InvalidOperationException("Negative exclusive profiler cost; overlapping scopes invalidate attribution.");
+        ref var row = ref _profileValues![_profileTick * ProfileSlots + slot];
+        row.Calls++; row.Inclusive += inclusive; row.Exclusive += exclusive; row.Bytes += bytes;
+    }
+
+    private static void FinishProfile()
+    {
+        if (_profileValues == null) return;
+        using var writer = new StreamWriter(Path.Combine(_output, "system-phases.csv"));
+        writer.WriteLine("relative_tick,kind,name,calls,inclusive_ms,exclusive_ms,exclusive_allocated_bytes");
+        for (var tick = 0; tick < _duration; tick++)
+        for (var slot = 0; slot < ProfileSlots; slot++)
+        {
+            var row = _profileValues[tick * ProfileSlots + slot];
+            if (row.Calls == 0) continue;
+            var kind = slot < ProfilePhaseBase ? "system" : slot < ProfileDriver ? "phase" : "native";
+            var name = slot < ProfilePhaseBase ? ProfileSystemNames[slot]
+                : slot < ProfileDriver ? ProfilePhaseNames[slot - ProfilePhaseBase]
+                : slot == ProfileDriver ? "Driver" : "Observer";
+            writer.WriteLine(FormattableString.Invariant($"{tick},{kind},{name},{row.Calls},{row.Inclusive * 1000d / Stopwatch.Frequency:R},{row.Exclusive * 1000d / Stopwatch.Frequency:R},{row.Bytes}"));
+        }
+        AtomicJson("phase-histograms.json", new { before = _profileWarmPhases, after = ProfilePhaseTotals?.Invoke(), scope = "Inclusive per-invocation duration histogram deltas; powers-of-two stopwatch buckets, separate from exclusive per-tick CSV" });
+        _profileValues = null; _profileTick = -1; _profileSystem = -1;
+    }
+}
diff --git a/Tools/KiasBenchmark/Server/ScannerUiLab.cs b/Tools/KiasBenchmark/Server/ScannerUiLab.cs
new file mode 100644
index 0000000000..9f8528613e
--- /dev/null
+++ b/Tools/KiasBenchmark/Server/ScannerUiLab.cs
@@ -0,0 +1,115 @@
+using System.IO;
+using System.Linq;
+using System.Numerics;
+using System.Text.Json;
+using Content.Server._Forge.KIAS;
+using Content.Server.Damage.Systems;
+using Content.Server.GameTicking;
+using Content.Server.Power.EntitySystems;
+using Content.Shared._Forge.KIAS;
+using Content.Shared._NF.Shipyard.Components;
+using Content.Shared.Mind;
+using Content.Shared.Power.Components;
+using Robust.Server.GameObjects;
+using Robust.Server.Player;
+using Robust.Shared.Console;
+using Robust.Shared.EntitySerialization.Systems;
+using Robust.Shared.Enums;
+using Robust.Shared.Map;
+using Robust.Shared.Timing;
+using Robust.Shared.Utility;
+
+namespace Content.Server.Benchmark;
+
+public sealed class KiasScannerUiStartCommand : IConsoleCommand
+{
+    public string Command => "kias_lab_scanner_server";
+    public string Description => "Prepare real Briar scanner UI acceptance.";
+    public string Help => Command;
+    public void Execute(IConsoleShell shell, string argStr, string[] args) => IoCManager.Resolve<IEntityManager>().System<KiasScannerUiLabSystem>().Start();
+}
+
+public sealed class KiasScannerUiLabSystem : EntitySystem
+{
+    [Dependency] private IPlayerManager _players = default!;
+    [Dependency] private IGameTiming _timing = default!;
+    private EntityUid _grid, _actor;
+    private bool _started, _opened;
+    private int _index;
+    private TimeSpan _next;
+    private string _output = string.Empty;
+    private EntityUid[] _targets = Array.Empty<EntityUid>();
+    private static readonly Vector2[] Positions = { new(-10.5f, 2.5f), new(-4.5f, 2.5f), new(-.5f, 35.5f), new(3.5f, 35.5f) };
+    public void Start()
+    {
+        _output = Environment.GetEnvironmentVariable("KIAS_LAB_SCANNER_OUTPUT") ?? throw new InvalidOperationException("Scanner output required.");
+        var maps = EntityManager.System<SharedMapSystem>();
+        maps.CreateMap(out var map, runMapInit: false);
+        if (!EntityManager.System<MapLoaderSystem>().TryLoadGrid(map, new ResPath("/Maps/_Forge/KIAS/Fixtures/briarKIAS.yml"), out var loaded)) throw new InvalidOperationException("Briar did not load.");
+        _grid = loaded!.Value.Owner;
+        _targets = Positions.Select(position => Devices<KiasRoomScannerComponent>().Single(uid => Vector2.DistanceSquared(Transform(uid).LocalPosition, position) < .01f)).ToArray();
+        Charge();
+        maps.InitializeMap(map);
+        _started = true;
+        File.WriteAllText(Path.Combine(_output, "server-bootstrap.json"), "{\"status\":\"WAITING_FOR_REAL_CLIENT\"}");
+    }
+    private EntityUid[] Devices<T>() where T : Component
+    {
+        var result = new List<EntityUid>();
+        var query = EntityManager.AllEntityQueryEnumerator<T, TransformComponent>();
+        while (query.MoveNext(out var uid, out _, out var transform)) if (transform.GridUid == _grid) result.Add(uid);
+        return result.ToArray();
+    }
+    private void Charge()
+    {
+        foreach (var uid in Devices<BatteryComponent>()) EntityManager.System<BatterySystem>().SetCharge(uid, Comp<BatteryComponent>(uid).MaxCharge);
+    }
+    public override void Update(float frameTime)
+    {
+        if (!_started || _timing.CurTime < _next) return;
+        _next = _timing.CurTime + TimeSpan.FromSeconds(.5);
+        try
+        {
+            Charge();
+            if (!_actor.Valid)
+            {
+                var session = _players.Sessions.FirstOrDefault();
+                if (session == null || session.Data.ContentDataUncast == null) return;
+                _actor = Spawn("MobHuman", new EntityCoordinates(_grid, Positions[0] - Vector2.UnitY));
+                EntityManager.System<GodmodeSystem>().EnableGodmode(_actor);
+                EnsureComp<ShipOwnershipComponent>(_grid).OwnerUserId = session.UserId;
+                var minds = EntityManager.System<SharedMindSystem>();
+                minds.TransferTo(minds.CreateMind(session.UserId), _actor);
+                if (session.Status == SessionStatus.Connected) _players.JoinGame(session);
+                else EntityManager.System<GameTicker>().PlayerJoinGame(session, silent: true);
+            }
+            if (_index == _targets.Length) return;
+            var target = _targets[_index];
+            var ui = EntityManager.System<UserInterfaceSystem>();
+            if (!_opened)
+            {
+                var kias = EntityManager.System<KiasSystem>();
+                if (!kias.IsOnline(target) || kias.TopologyPending(_grid)) return;
+                var transform = Transform(target);
+                var position = transform.LocalPosition + transform.LocalRotation.RotateVec(-Vector2.UnitY);
+                EntityManager.System<SharedTransformSystem>().SetCoordinates(_actor, new EntityCoordinates(_grid, position));
+                if (!ui.TryOpenUi(target, KiasUiKey.Scanner, _actor)) throw new InvalidOperationException("Actual scanner BUI open failed.");
+                _opened = true;
+                var geometry = EntityManager.System<KiasDisplaySystem>().BuildCoverage(_grid, target);
+                if (_index == 0 && (geometry.RoomStatus != "Ok" || geometry.TileCount != 9 || geometry.DoorCount != 4)) throw new InvalidOperationException("Briar (-11,2) geometry mismatch.");
+                if (_index >= 2 && (geometry.RoomStatus != "ExteriorSector" || geometry.TileCount == 0)) throw new InvalidOperationException("Exterior scanner geometry mismatch.");
+                File.WriteAllText(Path.Combine(_output, $"server-case-{_index}.json"), JsonSerializer.Serialize(new { index = _index, target = target.ToString(), position = new { X = transform.LocalPosition.X, Y = transform.LocalPosition.Y }, powered = true, geometry }, new JsonSerializerOptions { IncludeFields = true, WriteIndented = true }));
+            }
+            if (!File.Exists(Path.Combine(_output, $"client-case-{_index}.json"))) return;
+            ui.CloseUi(target, KiasUiKey.Scanner, _actor);
+            _opened = false;
+            _index++;
+            if (_index == _targets.Length) File.WriteAllText(Path.Combine(_output, "server-completed.json"), "{\"status\":\"PASS\",\"cases\":4,\"authorMapChanged\":false}");
+        }
+        catch (Exception error)
+        {
+            File.WriteAllText(Path.Combine(_output, "server-failed.json"), JsonSerializer.Serialize(new { error = error.ToString(), index = _index }));
+            _started = false;
+        }
+    }
+}
diff --git a/Tools/KiasBenchmark/benchmark.ps1 b/Tools/KiasBenchmark/benchmark.ps1
new file mode 100644
index 0000000000..d122892849
--- /dev/null
+++ b/Tools/KiasBenchmark/benchmark.ps1
@@ -0,0 +1,87 @@
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateSet('Diagnose', 'AuditShip', 'FunctionalGate', 'Regression', 'PersistenceCheck', 'CrossCheck', 'VisualCheck', 'PowerCheck', 'PhysicalGate', 'CompileScenario', 'Report', 'Status')]
+    [string]$Action,
+    [int]$Seed = 20261009,
+    [ValidateRange(1, 40)][int]$Ships = 40,
+    [string]$Python = 'python'
+)
+$ErrorActionPreference = 'Stop'
+$repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$outputDir = Join-Path $repoRoot '.kias-benchmark'
+New-Item -ItemType Directory -Force -Path $outputDir | Out-Null
+Push-Location $repoRoot
+try {
+    if ($Action -eq 'VisualCheck') {
+        & dotnet build Content.Client/Content.Client.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabVisual=true *> (Join-Path $outputDir 'ui-build.log')
+        if ($LASTEXITCODE -ne 0) { throw 'Visual laboratory client did not build; see ui-build.log.' }
+        $labClient = $null
+        $oldSandbox = $env:ROBUST_DISABLE_SANDBOX
+        $oldVisualOutput = $env:KIAS_LAB_UI_OUTPUT
+        try {
+            $env:ROBUST_DISABLE_SANDBOX = '1'
+            $env:KIAS_LAB_UI_OUTPUT = Join-Path $outputDir 'ui'
+            $complete = Join-Path $env:KIAS_LAB_UI_OUTPUT 'completed.json'
+            if (Test-Path -LiteralPath $complete) { Remove-Item -LiteralPath $complete }
+            $labClient = Start-Process -FilePath (Join-Path $repoRoot 'bin/Content.Client/Content.Client.exe') -ArgumentList '+kias_lab_visual', '--cvar', 'display.windowmode=0', '--cvar', 'culture=ru-RU', '--cvar', 'display.uiScale=1', '--cvar', 'interface.resolutionAutoScaleEnabled=false' -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $outputDir 'ui-client.log') -RedirectStandardError (Join-Path $outputDir 'ui-client-error.log')
+            $deadline = (Get-Date).AddMinutes(4)
+            while (-not (Test-Path -LiteralPath $complete) -and -not $labClient.HasExited -and (Get-Date) -lt $deadline) { Start-Sleep -Seconds 2; $labClient.Refresh() }
+            if (-not (Test-Path -LiteralPath $complete)) { throw 'Visual capture did not complete; see ui-client.log.' }
+            Write-Host 'Desktop captures saved in .kias-benchmark/ui. Visual review is required.'
+        } finally {
+            if ($null -ne $labClient -and -not $labClient.HasExited) { Stop-Process -Id $labClient.Id }
+            $env:ROBUST_DISABLE_SANDBOX = $oldSandbox
+            $env:KIAS_LAB_UI_OUTPUT = $oldVisualOutput
+            & dotnet build Content.Client/Content.Client.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabVisual=false *> (Join-Path $outputDir 'ui-restore-build.log')
+            if ($LASTEXITCODE -ne 0) { throw 'Normal client rebuild failed; see ui-restore-build.log.' }
+        }
+        return
+    }
+    if ($Action -in @('FunctionalGate', 'Regression', 'PersistenceCheck', 'CrossCheck', 'PowerCheck', 'PhysicalGate')) {
+        $env:KIAS_LAB_OUTPUT = Join-Path $outputDir 'live'
+        $filter = 'FullyQualifiedName~SavedBriarLoadsAndScannerModulesSurviveRoundTrip'
+        $logName = 'functional-gate.log'
+        $trxName = 'briar.trx'
+        if ($Action -eq 'FunctionalGate') {
+            $filter = 'FullyQualifiedName~KiasBriar'
+            $logName = 'briar-all.log'
+            $trxName = 'briar-all.trx'
+        }
+        if ($Action -eq 'Regression') {
+            $filter = 'FullyQualifiedName~Tests._Forge.KIAS'
+            $logName = 'kias-regression.log'
+            $trxName = 'kias-regression.trx'
+        }
+        if ($Action -eq 'CrossCheck') {
+            $filter = 'FullyQualifiedName~KiasBriarCrossGateTests'
+            $logName = 'cross-check.log'
+            $trxName = 'cross.trx'
+        }
+        if ($Action -eq 'PowerCheck') {
+            $filter = 'FullyQualifiedName~SavedBriarReceivesRealBatteryPowerAndResolvesGraphTargets'
+            $logName = 'powered-check.log'
+            $trxName = 'powered.trx'
+        }
+        if ($Action -eq 'PhysicalGate') {
+            $filter = 'FullyQualifiedName~KiasBriarPhysicalGateTests'
+            $logName = 'physical-gate.log'
+            $trxName = 'physical.trx'
+        }
+        & dotnet test Content.IntegrationTests/Content.IntegrationTests.csproj -c Release --no-restore -m:4 -nr:false --filter $filter --logger "trx;LogFileName=$trxName" --results-directory (Join-Path $outputDir 'tests') *> (Join-Path $outputDir $logName)
+        $gateExit = $LASTEXITCODE
+        if ($Action -in @('PowerCheck', 'PhysicalGate', 'CrossCheck', 'FunctionalGate', 'Regression')) {
+            & $Python (Join-Path $PSScriptRoot 'lab.py') Report
+            if ($gateExit -ne 0) { throw "$Action failed. See $outputDir/$logName" }
+            return
+        }
+        & $Python (Join-Path $PSScriptRoot 'lab.py') RecordGate --exit-code $gateExit
+        if ($LASTEXITCODE -ne 0) { throw 'Could not record functional gate results.' }
+        if ($gateExit -ne 0) { throw "Briar load/round-trip failed. See $outputDir/functional-gate.log" }
+        Write-Host 'Briar persistence check completed. This is not the 27-program functional gate; see FUNCTIONAL_REPORT.md.'
+    } else {
+        & $Python (Join-Path $PSScriptRoot 'lab.py') $Action --seed $Seed --ships $Ships
+        if ($LASTEXITCODE -ne 0) { throw "Laboratory action failed: $Action" }
+    }
+} finally {
+    Pop-Location
+}
diff --git a/Tools/KiasBenchmark/benchmark_lock.ps1 b/Tools/KiasBenchmark/benchmark_lock.ps1
new file mode 100644
index 0000000000..1acc7d3b43
--- /dev/null
+++ b/Tools/KiasBenchmark/benchmark_lock.ps1
@@ -0,0 +1,46 @@
+function Enter-KiasBenchmarkLease([string]$Repository) {
+    $taskLeasePath=[IO.Path]::GetFullPath((Join-Path $Repository '.kias-benchmark/execution.lock'))
+    if (-not (Get-Variable -Name KiasBenchmarkLeases -Scope Global -ErrorAction SilentlyContinue)) {
+        $global:KiasBenchmarkLeases=@{}
+    }
+    if ($global:KiasBenchmarkLeases.ContainsKey($taskLeasePath)) {
+        $global:KiasBenchmarkLeases[$taskLeasePath].Depth++
+        return $taskLeasePath
+    }
+    New-Item -ItemType Directory -Path ([IO.Path]::GetDirectoryName($taskLeasePath)) -Force | Out-Null
+    try { $taskLeaseStream=[IO.File]::Open($taskLeasePath,'OpenOrCreate','ReadWrite','None') }
+    catch { throw 'BENCHMARK_BUSY: другая сборка или проверка KIAS уже работает. Дождитесь её завершения.' }
+    try {
+        $taskLeaseStream.SetLength(0)
+        $taskLeaseBytes=[Text.Encoding]::UTF8.GetBytes((@{pid=$PID;startedUtc=[DateTime]::UtcNow.ToString('o')} | ConvertTo-Json -Compress))
+        $taskLeaseStream.Write($taskLeaseBytes,0,$taskLeaseBytes.Length)
+        $taskLeaseStream.Flush()
+        $global:KiasBenchmarkLeases[$taskLeasePath]=@{Stream=$taskLeaseStream;Depth=1}
+    } catch { $taskLeaseStream.Dispose(); throw }
+    return $taskLeasePath
+}
+
+function Exit-KiasBenchmarkLease([string]$Lease) {
+    if (-not $Lease -or -not $global:KiasBenchmarkLeases.ContainsKey($Lease)) { return }
+    $taskLeaseEntry=$global:KiasBenchmarkLeases[$Lease]
+    $taskLeaseEntry.Depth--
+    if ($taskLeaseEntry.Depth -eq 0) {
+        $taskLeaseEntry.Stream.Dispose()
+        $global:KiasBenchmarkLeases.Remove($Lease)
+    }
+}
+
+function Test-KiasBenchmarkPorts([int]$GamePort=12299,[int]$MetricsPort=44880) {
+    foreach ($taskPort in @($GamePort,$MetricsPort)) {
+        $taskListener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,$taskPort)
+        $taskListener.Server.ExclusiveAddressUse=$true
+        try { $taskListener.Start() }
+        catch { throw "BENCHMARK_PORT_BUSY: TCP $taskPort занят; сервер не запущен." }
+        finally { $taskListener.Stop() }
+    }
+    $taskUdp=[Net.Sockets.Socket]::new([Net.Sockets.AddressFamily]::InterNetwork,[Net.Sockets.SocketType]::Dgram,[Net.Sockets.ProtocolType]::Udp)
+    $taskUdp.ExclusiveAddressUse=$true
+    try { $taskUdp.Bind([Net.IPEndPoint]::new([Net.IPAddress]::Loopback,$GamePort)) }
+    catch { throw "BENCHMARK_PORT_BUSY: UDP $GamePort занят; сервер не запущен." }
+    finally { $taskUdp.Dispose() }
+}
diff --git a/Tools/KiasBenchmark/build_pair.ps1 b/Tools/KiasBenchmark/build_pair.ps1
new file mode 100644
index 0000000000..a6703114f7
--- /dev/null
+++ b/Tools/KiasBenchmark/build_pair.ps1
@@ -0,0 +1,94 @@
+param([Parameter(Mandatory)][string]$OutputDirectory, [string]$Base)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'benchmark_lock.ps1')
+$taskBenchmarkLease=Enter-KiasBenchmarkLease (Join-Path $PSScriptRoot '../..')
+try {
+    Test-KiasBenchmarkPorts
+function Invoke-TrackedReleaseBuild([string]$Source,[string]$Project,[string]$Log,[string]$Label) {
+    $taskBuildClock=[Diagnostics.Stopwatch]::StartNew()
+    $taskDotnet=(Get-Command dotnet -ErrorAction Stop).Source
+    $taskBuildProcess=$null
+    try {
+        $taskBuildProcess=Start-Process -FilePath $taskDotnet -WorkingDirectory $Source -ArgumentList @('build',$Project,'-c','Release','-m:4','-nr:false') -WindowStyle Hidden -PassThru -RedirectStandardOutput $Log -RedirectStandardError ($Log+'.stderr.log')
+        while (-not $taskBuildProcess.HasExited) {
+            Start-Sleep -Seconds 5
+            $taskBuildProcess.Refresh()
+            $taskCompletedProjects=if (Test-Path -LiteralPath $Log) {@(Select-String -LiteralPath $Log -SimpleMatch ' -> ').Count} else {0}
+            $taskHeartbeat=@{label=$Label;status='BUILDING';wallSeconds=$taskBuildClock.Elapsed.TotalSeconds;projectsReported=$taskCompletedProjects;etaSeconds=$null;updatedUtc=[DateTime]::UtcNow.ToString('o');log=$Log}
+            $taskHeartbeat | ConvertTo-Json | Set-Content -LiteralPath ($Log+'.progress.tmp') -Encoding utf8
+            Move-Item -LiteralPath ($Log+'.progress.tmp') -Destination ($Log+'.progress.json') -Force
+            Write-Host ('Сборка {0} | прошло {1} | завершённых проектов {2} | ETA вычисляется | журнал {3}' -f $Label,$taskBuildClock.Elapsed.ToString('hh\:mm\:ss'),$taskCompletedProjects,$Log)
+        }
+        $taskBuildProcess.WaitForExit()
+        $taskCode=$taskBuildProcess.ExitCode
+        @{label=$Label;status=$(if ($taskCode -eq 0) {'COMPLETE'} else {'FAILED'});exitCode=$taskCode;wallSeconds=$taskBuildClock.Elapsed.TotalSeconds;updatedUtc=[DateTime]::UtcNow.ToString('o');log=$Log} | ConvertTo-Json | Set-Content -LiteralPath ($Log+'.progress.json') -Encoding utf8
+        if ($taskCode -ne 0) { throw "Release build $Label failed; see $Log and $Log.stderr.log" }
+    } finally {
+        if ($null -ne $taskBuildProcess -and -not $taskBuildProcess.HasExited) { Stop-Process -Id $taskBuildProcess.Id }
+    }
+}
+$repo = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$output = [IO.Path]::GetFullPath($OutputDirectory)
+if (Test-Path -LiteralPath (Join-Path $output 'builds')) { throw 'BuildPair refuses to overwrite existing builds.' }
+New-Item -ItemType Directory -Path $output -Force | Out-Null
+Push-Location $repo
+try {
+    $taskEngineStatus=@(& git -C (Join-Path $repo 'RobustToolbox') status --porcelain)
+    if ($LASTEXITCODE -ne 0) { throw 'Cannot verify engine working tree.' }
+    if ($taskEngineStatus.Count) { throw 'Engine working tree contains changes; isolated builds require the recorded clean engine revision.' }
+    $fingerprint = & python (Join-Path $PSScriptRoot 'source_fingerprint.py') | ConvertFrom-Json
+    if ($LASTEXITCODE -ne 0) { throw 'Source fingerprint failed.' }
+    $fingerprint | ConvertTo-Json -Depth 8 | Set-Content (Join-Path $output 'source-fingerprint.json') -Encoding utf8
+    if (-not $Base) {
+        $reference = Get-Content (Join-Path $repo '.kias-benchmark/BASELINE_MANIFEST.json') -Raw | ConvertFrom-Json
+        $Base = $reference.base
+    }
+    $base = (& git merge-base $Base HEAD).Trim()
+    if ($LASTEXITCODE -ne 0) { throw 'Cannot determine common source baseline.' }
+    & python (Join-Path $PSScriptRoot 'prepare_pair.py') --directory $output --base $base *> (Join-Path $output 'prepare.log')
+    if ($LASTEXITCODE -ne 0) { throw "Matched source preparation failed: $output/prepare.log" }
+    $manifestPath = Join-Path $output 'BASELINE_MANIFEST.json'
+    $manifest = Get-Content $manifestPath -Raw | ConvertFrom-Json
+    $manifest | Add-Member -NotePropertyName sourceFingerprint -NotePropertyValue $fingerprint.sha256
+    $manifest | Add-Member -NotePropertyName sdk -NotePropertyValue ((& dotnet --version).Trim())
+    foreach ($build in $manifest.builds) {
+        Write-Host "Сборка Release $($build.label)..."
+        Invoke-TrackedReleaseBuild $build.source 'Content.Server/Content.Server.csproj' (Join-Path $output "build-$($build.label).log") ('server-'+$build.label)
+        & python (Join-Path $PSScriptRoot 'instrument_headless_client.py') (Join-Path $build.source 'RobustToolbox') *> (Join-Path $output "client-instrumentation-$($build.label).json")
+        if ($LASTEXITCODE -ne 0) { throw 'Headless client instrumentation failed.' }
+        Invoke-TrackedReleaseBuild $build.source 'Content.Client/Content.Client.csproj' (Join-Path $output "build-client-$($build.label).log") ('client-'+$build.label)
+        $taskClientHashes=@{}
+        foreach ($taskAssembly in Get-ChildItem -LiteralPath (Join-Path $build.source 'bin/Content.Client') -Filter '*.dll') {
+            $taskClientHashes[$taskAssembly.Name]=(Get-FileHash -LiteralPath $taskAssembly.FullName).Hash.ToLowerInvariant()
+        }
+        $build | Add-Member -NotePropertyName clientRuntimeAssemblyHashes -NotePropertyValue $taskClientHashes
+        $build.compiled = $true
+        $taskRuntimeHashes = @{}
+        foreach ($taskAssembly in Get-ChildItem -LiteralPath (Join-Path $build.source 'bin/Content.Server') -Filter '*.dll') {
+            $taskRuntimeHashes[$taskAssembly.Name] = (Get-FileHash -LiteralPath $taskAssembly.FullName).Hash.ToLowerInvariant()
+        }
+        $build | Add-Member -NotePropertyName runtimeAssemblyHashes -NotePropertyValue $taskRuntimeHashes
+        foreach ($entry in @{
+            assemblySha256 = 'bin/Content.Server/Content.Server.dll'
+            nativeLabSha256 = 'Tools/KiasBenchmark/Server/NativeLab.cs'
+            nativeGameDriversSha256 = 'Tools/KiasBenchmark/Server/NativeGameDrivers.cs'
+            nativeProfilerSha256 = 'Tools/KiasBenchmark/Server/NativeProfiler.cs'
+        }.GetEnumerator()) {
+            $build | Add-Member -NotePropertyName $entry.Key -NotePropertyValue (Get-FileHash (Join-Path $build.source $entry.Value)).Hash.ToLowerInvariant()
+        }
+        if ($build.label -eq 'B') {
+            $build | Add-Member -NotePropertyName telemetrySha256 -NotePropertyValue (Get-FileHash (Join-Path $build.source 'Tools/KiasBenchmark/Server/KiasTelemetry.cs')).Hash.ToLowerInvariant()
+        }
+        $manifest | ConvertTo-Json -Depth 10 | Set-Content $manifestPath -Encoding utf8
+    }
+    $current = & python (Join-Path $PSScriptRoot 'source_fingerprint.py') | ConvertFrom-Json
+    if ($current.sha256 -ne $fingerprint.sha256) { throw 'REBUILD_REQUIRED: source changed while compiling the pair.' }
+    $manifest.status = 'MATCHED_RELEASE_BUILDS_COMPLETE_RUNTIME_NOT_TESTED'
+    $manifest | ConvertTo-Json -Depth 10 | Set-Content $manifestPath -Encoding utf8
+    Write-Host "Готовы свежие A/B. Манифест: $manifestPath"
+} catch {
+    @{ status='FAIL'; error=$_.Exception.Message } | ConvertTo-Json | Set-Content (Join-Path $output 'build-failed.json') -Encoding utf8
+    throw
+} finally { Pop-Location }
+
+} finally { Exit-KiasBenchmarkLease $taskBenchmarkLease }
diff --git a/Tools/KiasBenchmark/compare_native.py b/Tools/KiasBenchmark/compare_native.py
new file mode 100644
index 0000000000..433d09ad1c
--- /dev/null
+++ b/Tools/KiasBenchmark/compare_native.py
@@ -0,0 +1,116 @@
+"""Validate the limited neutral replay; never promote it to full benchmark acceptance."""
+import argparse, csv, json, math, statistics
+from pathlib import Path
+
+
+def read(path, name):
+    return json.loads((path / name).read_text(encoding='utf-8-sig'))
+
+
+def validate(path):
+    log = path / 'server.log'
+    if log.exists():
+        content = log.read_text(encoding='utf-8-sig', errors='replace')
+        assert '[ERRO]' not in content and '[FATL]' not in content, 'Server errors invalidate replay evidence.'
+    start = read(path, 'started.json')
+    end = read(path, 'completed.json')
+    assert end['status'] == 'PARTIAL_NATIVE_DRY_RUN_COMPLETE'
+    assert start['tickRate'] == 60
+    assert start['ships'] == end['ships'] > 0
+    assert start['measuredTicks'] == end['measuredTicks'] > 0
+    with (path / 'ticks.csv').open(encoding='utf-8-sig', newline='') as stream:
+        ticks = list(csv.DictReader(stream))
+    assert [int(row['relative_tick']) for row in ticks] == list(range(end['measuredTicks']))
+    assert all(float(row['content_engine_ms']) >= 0 and int(row['allocated_bytes']) >= 0 for row in ticks)
+    events = [json.loads(line) for line in (path / 'events.jsonl').read_text().splitlines()]
+    assert len(events) == end['deliveredEvents'] == start.get('plannedEvents', 8)
+    expected = {'fire.start': ('burning', True), 'fire.clear': ('burning', False),
+                'power.loss': ('disabled', True), 'power.restore': ('disabled', False),
+                'crew.critical': ('mobState', 'Critical'), 'crew.recover': ('mobState', 'Alive'),
+                'light.power_off': ('on', False), 'light.power_on': ('on', True),
+                'radiation.start': ('enabled', True), 'radiation.clear': ('enabled', False),
+                'anomaly.start': ('active', True), 'anomaly.clear': ('active', False),
+                'hull.damage': ('damaged', True), 'hull.repair': ('damaged', False)}
+    declared = set(start.get('driverTypes', list(expected)[:8]))
+    assert declared <= set(expected), 'Unsupported declared driver.'
+    assert set(event['type'] for event in events) == declared, 'Missing declared driver.'
+    if 'whole_tick_ms' in ticks[0]:
+        assert all(float(row['whole_tick_ms']) >= float(row['content_engine_ms']) for row in ticks)
+        assert all(float(row['gc_pause_ms']) >= 0 and int(row['whole_allocated_bytes']) >= 0 for row in ticks)
+    assert len({event['id'] for event in events}) == len(events), 'Duplicate causal input ID.'
+    bindings = read(path, 'bindings.json')
+    ships = {binding['ship'] for binding in bindings}
+    assert len(bindings) == len(ships) == start['ships']
+    for event in events:
+        assert event['scheduledTick'] == event['actualTick']
+        assert 0 <= event['actualTick'] < end['measuredTicks']
+        assert event['ship'] in ships
+        field, value = expected[event['type']]
+        assert event['nativeEffect'][field] == value, event
+        if event['type'] == 'anomaly.start':
+            assert event['nativeEffect'].get('prototype') == 'AnomalyFlesh', event
+            assert event['nativeEffect'].get('excludedHazardsAbsent') is True, event
+    return start, end, events, bindings
+
+
+def compare(a, b):
+    for path in (a, b):
+        if (path / 'run-manifest.json').exists():
+            assert read(path, 'run-manifest.json').get('performanceEligible', True), 'Accelerated diagnostic replay is not performance evidence.'
+    sa, ea, ia, ba = validate(a)
+    sb, eb, ib, bb = validate(b)
+    assert sa['scenarioSha256'] == sb['scenarioSha256']
+    assert sa['warmupTicks'] == sb['warmupTicks']
+    assert ea['measuredTicks'] == eb['measuredTicks']
+    assert ba == bb, 'Native fixture bindings differ.'
+    fields = ('id', 'ship', 'type', 'scheduledTick', 'actualTick')
+    assert [tuple(e[k] for k in fields) for e in ia] == [tuple(e[k] for k in fields) for e in ib]
+    return {'status': 'PARTIAL_NATIVE_INPUT_AND_BINDING_PARITY_PASS', 'ships': sa['ships'],
+            'measuredTicksPerVariant': ea['measuredTicks'], 'eventsPerVariant': len(ia),
+            'driverTypes': sorted({event['type'] for event in ia}),
+            'scenarioSha256': sa['scenarioSha256'], 'a': str(a), 'b': str(b),
+            'runFingerprints': {label: read(path, 'run-manifest.json') if (path / 'run-manifest.json').exists() else None
+                                for label, path in (('A', a), ('B', b))},
+            'contentMetrics': {'A': content_metrics(a), 'B': content_metrics(b)},
+            'scope': 'Declared native driver pairs and stable bindings; not complete gameplay workload or full runtime world parity.',
+            'limitations': ['Crew actors are real minded humans without KIAS transponders; native critical/recover input parity does not validate CrewCritical graph execution.'],
+            'fullBenchmark': 'NOT_RUN'}
+
+
+def content_metrics(path):
+    with (path / 'ticks.csv').open(encoding='utf-8-sig', newline='') as stream:
+        rows = list(csv.DictReader(stream))
+    times = sorted(float(row['content_engine_ms']) for row in rows)
+    percentile = lambda fraction: times[max(0, math.ceil(len(times) * fraction) - 1)]
+    result = {'scope': 'Content PreEngine to PostEngine',
+            'samples': len(times), 'meanMs': statistics.mean(times), 'medianMs': statistics.median(times),
+            'p95Ms': percentile(.95), 'p99Ms': percentile(.99), 'maxMs': times[-1],
+            'over60TpsBudget': sum(value > 1000 / 60 for value in times),
+            'meanAllocatedBytes': statistics.mean(int(row['allocated_bytes']) for row in rows),
+            'peakWorkingSetBytes': max(int(row['working_set_bytes']) for row in rows)}
+    if 'whole_tick_ms' in rows[0]:
+        whole = sorted(float(row['whole_tick_ms']) for row in rows)
+        result['wholeTick'] = {
+            'scope': 'Robust.GameLoop TickStart to TickStop; input/frame update outside Tick excluded',
+            'meanMs': statistics.mean(whole), 'medianMs': statistics.median(whole),
+            'p95Ms': whole[math.ceil(len(whole) * .95)-1], 'p99Ms': whole[math.ceil(len(whole) * .99)-1],
+            'p999Ms': whole[math.ceil(len(whole) * .999)-1], 'maxMs': whole[-1],
+            'over60TpsBudget': sum(value > 1000/60 for value in whole),
+            'meanAllocatedBytes': statistics.mean(int(row['whole_allocated_bytes']) for row in rows),
+            'meanThreadAllocatedBytes': statistics.mean(int(row['thread_allocated_bytes']) for row in rows),
+            'gcPauseMs': sum(float(row['gc_pause_ms']) for row in rows),
+            'gcCollections': {str(generation): int(rows[-1][f'gc{generation}'])-int(rows[0][f'gc{generation}']) for generation in range(3)},
+            'cpuSeconds': float(rows[-1]['cpu_seconds'])-float(rows[0]['cpu_seconds']),
+        }
+    return result
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('a', type=Path)
+    parser.add_argument('b', type=Path)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    result = compare(args.a, args.b)
+    args.output.write_text(json.dumps(result, indent=2), encoding='utf-8')
+    print(json.dumps(result, indent=2))
diff --git a/Tools/KiasBenchmark/cost_attribution.py b/Tools/KiasBenchmark/cost_attribution.py
new file mode 100644
index 0000000000..2e1188b6a5
--- /dev/null
+++ b/Tools/KiasBenchmark/cost_attribution.py
@@ -0,0 +1,127 @@
+"""Exclusive per-tick accounting; quantiles are never added across systems."""
+import csv
+import json
+import math
+from pathlib import Path
+import random
+import statistics
+from collections import defaultdict
+
+GROUPS=("core_topology","crew_rooms_integration","runtime_vm","runtime_io_actuation","other_kias","physics","common_engine","native_driver_observer","residual")
+
+
+def quantile(values, fraction):
+    values=sorted(values)
+    if not values: return None
+    rank=(len(values)-1)*fraction
+    lower=int(rank)
+    upper=min(lower+1,len(values)-1)
+    return values[lower]+(values[upper]-values[lower])*(rank-lower)
+
+
+def group(kind,name):
+    name=name.rsplit(".",1)[-1]
+    if kind=="native": return "native_driver_observer"
+    if kind=="phase":
+        if name in ("RuntimeCommands","IoCommand","IoEmit"): return "runtime_io_actuation"
+        if name.startswith("Runtime"): return "runtime_vm"
+        if name.startswith(("Crew","Integration","Room")): return "crew_rooms_integration"
+        return "other_kias"
+    if name=="PhysicsSystem": return "physics"
+    if name.startswith(("KiasCrew","KiasRoom","KiasIntegration")): return "crew_rooms_integration"
+    if name.startswith("KiasControllerRuntime"): return "runtime_vm"
+    if name.startswith("KiasControllerIo"): return "runtime_io_actuation"
+    if name in ("KiasSystem","KiasDeviceIdentitySystem"): return "core_topology"
+    return "other_kias" if name.startswith("Kias") else "common_engine"
+
+
+def read_run(directory):
+    directory=Path(directory)
+    manifest=json.loads((directory/"run-manifest.json").read_text(encoding="utf-8-sig"))
+    completed=json.loads((directory/"completed.json").read_text(encoding="utf-8-sig"))
+    config=json.loads((directory/"profile-config.json").read_text(encoding="utf-8-sig"))
+    assert not any((directory/name).exists() for name in ("failed.json","run-failed.json")), "Failed run cannot attribute normal cost"
+    assert manifest["performanceEligible"] is True, "Contaminated or functional-only run cannot certify CPU cost"
+    with (directory/"ticks.csv").open(encoding="utf-8-sig",newline="") as stream: rows=list(csv.DictReader(stream))
+    count=completed["measuredTicks"]
+    assert len(rows)==count and [int(row["relative_tick"]) for row in rows]==list(range(count)), "Missing or duplicate tick samples"
+    whole=[float(row["whole_tick_ms"]) for row in rows]
+    assert all(math.isfinite(value) and value>=0 for value in whole), "Invalid whole-tick values"
+    costs={name:[0.0]*count for name in GROUPS}
+    group_totals={name:dict(calls=0,bytes=0) for name in GROUPS}
+    methods=defaultdict(lambda:dict(calls=0,inclusiveMs=0.0,exclusiveMs=0.0,exclusiveBytes=0))
+    with (directory/"system-phases.csv").open(encoding="utf-8-sig",newline="") as stream:
+        for row in csv.DictReader(stream):
+            tick=int(row["relative_tick"]); value=float(row["exclusive_ms"])
+            assert 0<=tick<count and math.isfinite(value) and value>=0, "Invalid exclusive phase tick/cost"
+            category=group(row["kind"],row["name"])
+            costs[category][tick]+=value
+            group_totals[category]["calls"]+=int(row["calls"])
+            group_totals[category]["bytes"]+=int(row["exclusive_allocated_bytes"])
+            method=methods[(row["kind"],row["name"])]
+            method["calls"]+=int(row["calls"]);method["inclusiveMs"]+=float(row["inclusive_ms"])
+            method["exclusiveMs"]+=value;method["exclusiveBytes"]+=int(row["exclusive_allocated_bytes"])
+    costs["residual"]=[whole[tick]-sum(costs[name][tick] for name in GROUPS[:-1]) for tick in range(count)]
+    assert min(costs["residual"])>=-.05, "Overlapping scopes invalidate exclusive attribution"
+    lower,upper=quantile(whole,.45),quantile(whole,.55)
+    cohort=[i for i,value in enumerate(whole) if lower<=value<=upper]
+    metrics={name:dict(meanMs=statistics.mean(values),p50CohortMeanMs=statistics.mean(values[i] for i in cohort),callsPerTick=group_totals[name]["calls"]/count,exclusiveBytesPerTick=group_totals[name]["bytes"]/count) for name,values in costs.items()}
+    return dict(path=str(directory.resolve()),ticks=count,whole=dict(meanMs=statistics.mean(whole),p50Ms=statistics.median(whole),p95Ms=quantile(whole,.95),p99Ms=quantile(whole,.99),p999Ms=quantile(whole,.999),maxMs=max(whole),overBudgetTicks=sum(value>1000/60 for value in whole)),
+                groups=metrics,methods=[dict(kind=key[0],name=key[1],**value,meanExclusiveMsPerTick=value["exclusiveMs"]/count,callsPerTick=value["calls"]/count,exclusiveBytesPerTick=value["exclusiveBytes"]/count) for key,value in sorted(methods.items(),key=lambda item:item[1]["exclusiveMs"],reverse=True)],
+                rawWhole=whole,rawGroups=costs,config=config,manifest=manifest,
+                allocationsBytes=sum(int(row["whole_allocated_bytes"]) for row in rows),gcPauseMs=sum(float(row["gc_pause_ms"]) for row in rows))
+
+
+def block_interval(a,b,seed=20261013,repetitions=1000):
+    rng=random.Random(seed)
+    def blocks(values): return [statistics.mean(values[i:i+60]) for i in range(0,len(values),60)]
+    left,right=blocks(a),blocks(b)
+    samples=[statistics.mean(rng.choices(right,k=len(right)))-statistics.mean(rng.choices(left,k=len(left))) for _ in range(repetitions)]
+    return [quantile(samples,.025),quantile(samples,.975)]
+
+
+def report(directory):
+    directory=Path(directory)
+    state=json.loads((directory/"profile-status.json").read_text(encoding="utf-8-sig"))
+    results=[]
+    for item in state.get("completedRuns",[]):
+        run=read_run(item["path"])
+        results.append(dict(item,measurement=run))
+    comparisons=[]
+    for ships in (1,10,40):
+        for regime in ("IDLE","MIXED"):
+            a=[item["measurement"] for item in results if item["ships"]==ships and item["regime"]==regime and item["variant"]=="A" and item["probe"]=="NORMAL"]
+            b=[item["measurement"] for item in results if item["ships"]==ships and item["regime"]==regime and item["variant"]=="B" and item["probe"]=="NORMAL"]
+            if not a or not b: continue
+            delta=statistics.mean(run["whole"]["meanMs"] for run in b)-statistics.mean(run["whole"]["meanMs"] for run in a)
+            table=[]
+            for name in GROUPS:
+                av=statistics.mean(run["groups"][name]["meanMs"] for run in a);bv=statistics.mean(run["groups"][name]["meanMs"] for run in b)
+                table.append(dict(group=name,aMeanMs=av,bMeanMs=bv,deltaMeanMs=bv-av,
+                    bCallsPerTick=statistics.mean(run["groups"][name]["callsPerTick"] for run in b),
+                    bExclusiveBytesPerTick=statistics.mean(run["groups"][name]["exclusiveBytesPerTick"] for run in b),
+                    explainedFractionOfMeanDelta=(bv-av)/delta if abs(delta)>1e-9 else None))
+            unknown=next(row["deltaMeanMs"] for row in table if row["group"]=="residual")
+            comparisons.append(dict(ships=ships,regime=regime,aReplicates=len(a),bReplicates=len(b),deltaMeanMs=delta,
+                deltaP50Ms=statistics.mean(run["whole"]["p50Ms"] for run in b)-statistics.mean(run["whole"]["p50Ms"] for run in a),
+                meanDeltaBlock95Ci=block_interval([v for run in a for v in run["rawWhole"]],[v for run in b for v in run["rawWhole"]]),
+                replicateMeanRanges=dict(A=[min(run["whole"]["meanMs"] for run in a),max(run["whole"]["meanMs"] for run in a)],B=[min(run["whole"]["meanMs"] for run in b),max(run["whole"]["meanMs"] for run in b)]),
+                largeUnknown=abs(unknown)>max(.1,.2*abs(delta)),rankedExclusiveMean=sorted(table,key=lambda row:row["deltaMeanMs"],reverse=True)))
+    for item in results:
+        item["measurement"].pop("rawWhole");item["measurement"].pop("rawGroups")
+    result=dict(status="ATTRIBUTION_INCOMPLETE",optimizationComparison="NOT_YET_MEASURED",comparisons=comparisons,runs=results,
+        scope="Exclusive mean wall cost is additive. Whole-tick p50 delta is separate; p45-p55 cohorts describe typical ticks but are not a sum-of-medians decomposition. GC pause overlaps measured wall scopes and must not be added again.",
+        uncertainty="95% non-overlapping block bootstrap uses 60-tick blocks; independent replicate ranges and instrumentation ON/OFF probes must also be inspected. Profiling and ablation are not full gameplay acceptance.")
+    (directory/"cost-attribution.json").write_text(json.dumps(result,indent=2),encoding="utf-8")
+    text=["# Cost of KIAS","",result["status"],"",result["scope"],"",result["uncertainty"],""]
+    for item in comparisons:
+        text.extend([f"## {item['ships']} ships / {item['regime']}","",f"Whole mean delta {item['deltaMeanMs']:.6f} ms/tick; p50 delta {item['deltaP50Ms']:.6f} ms; mean block CI {item['meanDeltaBlock95Ci']}","","| Source | A exclusive mean ms/tick | B exclusive mean ms/tick | Delta | B calls/tick | B exclusive bytes/tick |","|---|---:|---:|---:|---:|---:|"])
+        for row in item["rankedExclusiveMean"]:text.append(f"| {row['group']} | {row['aMeanMs']:.6f} | {row['bMeanMs']:.6f} | {row['deltaMeanMs']:.6f} | {row['bCallsPerTick']:.3f} | {row['bExclusiveBytesPerTick']:.3f} |")
+        text.append("")
+    (directory/"COST_OF_KIAS.md").write_text("\n".join(text)+"\n",encoding="utf-8")
+    return result
+
+
+if __name__=="__main__":
+    import sys
+    report(Path(sys.argv[1]))
diff --git a/Tools/KiasBenchmark/deferred_smoke_scenario.py b/Tools/KiasBenchmark/deferred_smoke_scenario.py
new file mode 100644
index 0000000000..422b3a93d1
--- /dev/null
+++ b/Tools/KiasBenchmark/deferred_smoke_scenario.py
@@ -0,0 +1,33 @@
+"""Short native acceptance for previously deferred requirements; no ABBA claim."""
+import argparse
+import json
+from pathlib import Path
+
+STEPS = [
+    (120, "radiation.start"), (840, "radiation.clear"),
+    (1560, "radiation.start"), (2280, "radiation.clear"),
+    (3000, "light.power_off"), (3720, "light.power_on"),
+    (4440, "light.command_off"), (5160, "light.command_on"),
+    (5880, "hull.damage"), (6600, "hull.repair"),
+    (7320, "dock.dock"), (8040, "dock.undock"),
+    (8760, "ammo.finite_cycle"),
+]
+
+
+def generate(ships=1):
+    if not 1 <= ships <= 40:
+        raise ValueError("Expected 1..40 native ships")
+    return [dict(id=f"deferred-{index:02d}-{ship:04d}", tick=tick,
+                 ship=f"ship-{ship:04d}", type=kind)
+            for index, (tick, kind) in enumerate(STEPS)
+            for ship in range(1, ships + 1)]
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ships", type=int, default=1)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    events = generate(args.ships)
+    args.output.write_text("".join(json.dumps(event) + "\n" for event in events), encoding="utf-8")
+    print(json.dumps(dict(events=len(events), measuredTicks=11500, scope="SHORT_DEFERRED_ACCEPTANCE")))
diff --git a/Tools/KiasBenchmark/diagnostic_report.py b/Tools/KiasBenchmark/diagnostic_report.py
new file mode 100644
index 0000000000..dee87b7c89
--- /dev/null
+++ b/Tools/KiasBenchmark/diagnostic_report.py
@@ -0,0 +1,105 @@
+"""Describe complete and interrupted attempts without certifying partial measurements."""
+import csv
+import html
+import json
+import math
+from pathlib import Path
+import sys
+
+
+def read_json(path):
+    try:
+        return json.loads(path.read_text(encoding="utf-8-sig"))
+    except (OSError, ValueError):
+        return {}
+
+
+def summarize_run(attempt):
+    directory = Path(attempt["path"])
+    progress = read_json(directory / "progress.json")
+    ticks = []
+    malformed = 0
+    try:
+        with (directory / "ticks.csv").open(encoding="utf-8-sig", newline="") as stream:
+            for row in csv.DictReader(stream):
+                try:
+                    value = float(row["whole_tick_ms"])
+                    if not math.isfinite(value) or value < 0:
+                        raise ValueError()
+                    ticks.append(value)
+                except (ValueError, TypeError, KeyError):
+                    malformed += 1
+    except OSError:
+        pass
+    ticks.sort()
+    incidents = []
+    try:
+        for line in (directory / "log-incidents.jsonl").read_text(encoding="utf-8-sig").splitlines():
+            try:
+                incidents.append(json.loads(line))
+            except ValueError:
+                malformed += 1
+    except OSError:
+        pass
+    log_errors=0
+    first_log_error=None
+    for path in sorted(directory.glob("*.log")):
+        with path.open(encoding="utf-8-sig", errors="replace") as stream:
+            for number, line in enumerate(stream, 1):
+                if "[ERRO]" in line or "[FATL]" in line:
+                    log_errors+=1
+                    if first_log_error is None:
+                        first_log_error=dict(path=str(path), line=number, text=line[:4096].rstrip())
+    def percentile(fraction):
+        return ticks[min(len(ticks)-1, int((len(ticks)-1)*fraction))] if ticks else None
+    return dict(attempt, serverCompleted=(directory / "completed.json").exists(),
+                lastPhase=progress.get("phase"), lastTick=progress.get("currentTick"),
+                deliveredEvents=progress.get("deliveredEvents"), completedNative=progress.get("completedNative"),
+                pendingNative=progress.get("pendingNative"), tickSamples=len(ticks), malformedRows=malformed,
+                wholeTickMs=dict(p50=percentile(.5), p95=percentile(.95), p99=percentile(.99),
+                                 maximum=max(ticks) if ticks else None),
+                metricSnapshots=len(list(directory.glob("metrics-*.prom"))),
+                logErrorCount=log_errors, firstLogError=first_log_error,
+                logIncidentCount=len(incidents), firstIncident=incidents[0] if incidents else None,
+                lastIncident=incidents[-1] if incidents else None,
+                runFailure=read_json(directory / "run-failed.json"),
+                nativeFailure=read_json(directory / "failed.json"),
+                proofFiles={name:(directory / name).exists() for name in ("native-proof.json", "network-proof.json")})
+
+
+def report(series):
+    state = read_json(series / "status.json")
+    runs = [summarize_run(item) for item in state.get("attemptedRuns", [])]
+    # An interrupted collector may leave the active run outside attemptedRuns.
+    current = state.get("currentRun")
+    if current and not any(item.get("index") == current for item in runs):
+        path = series.parent / "runs" / f"{current}-{state.get('currentVariant')}"
+        if path.exists():
+            runs.append(summarize_run(dict(index=current, variant=state.get("currentVariant"), path=str(path),
+                                          valid=False, error="Collector interrupted before recording result")))
+    result = dict(status=state.get("status", "UNKNOWN"), diagnostic=True, strictReady=False,
+                  certification="NONE: owner waived remaining preflight; partial runs are not comparable ABBA",
+                  interpretation="Per-run tick percentiles cover persisted rows only. Unequal or invalid windows must not be used to claim A/B gains. Raw metrics, events, native outcomes and logs are retained alongside this summary.",
+                  attempts=runs, collectorError=state.get("error"))
+    def atomic(path, text):
+        temporary=path.with_suffix(path.suffix+".tmp")
+        temporary.write_text(text, encoding="utf-8")
+        temporary.replace(path)
+    atomic(series / "diagnostic-summary.json", json.dumps(result, indent=2, ensure_ascii=False))
+    lines = ["# Diagnostic ABBA", "", result["status"], "", result["certification"], "", result["interpretation"], "",
+             "| Run | Result | Server completed | Last tick | Samples | p95 ms | Native completed | Errors |",
+             "|---|---|---|---|---|---|---|---|"]
+    for row in runs:
+        lines.append(f"| {row['index']}-{row['variant']} | {'VALID_RUN' if row.get('valid') else 'INVALID / PARTIAL'} | {row['serverCompleted']} | {row['lastTick']} | {row['tickSamples']} | {row['wholeTickMs']['p95']} | {row['completedNative']} | {row['logErrorCount']} |")
+        if row.get("error"):
+            lines.extend(["", f"Run {row['index']}: {row['error']}", ""])
+    if state.get("error"):
+        lines.extend(["", "Collector failure: " + state["error"]])
+    markdown="\n".join(lines)+"\n"
+    atomic(series / "diagnostic-summary.md", markdown)
+    atomic(series / "diagnostic-summary.html", '<!doctype html><meta charset="utf-8"><title>Diagnostic ABBA</title><pre>'+html.escape(markdown)+'</pre>')
+    return result
+
+
+if __name__ == "__main__":
+    report(Path(sys.argv[1]).resolve())
