+    private static void PrepareCrewRegistration()
+    {
+        foreach (var ship in Ships.Values)
+        {
+            PrepareCrewBackpack(ship.Actor);
+            RegisterCrew?.Invoke(ship.Grid, ship.Actor);
+        }
+        _crewRegistered = true;
+    }
