+                Kind = KiasNodeKind.Specific, Profile = "Speaker", Binding = deletedNet }), Is.False);
+            EntityUid lateSpeaker = default;
+            for (var i = 0; i < 257; i++) lateSpeaker = em.SpawnEntity("KiasSpeaker", coordinates);
