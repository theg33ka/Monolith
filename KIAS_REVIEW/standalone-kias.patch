+            Spawn("KiasCore"); Spawn("KiasDataCable");
+            var programmer = Spawn("KiasControllerProgrammer");
+            var card = Spawn("KiasProgrammableController");
+            var actor = Spawn("MobHuman"); var other = Spawn("MobHuman");
