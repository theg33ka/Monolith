+    private Dictionary<Vector2i, Tile> DataFloors(EntityUid grid)
+        => EntityManager.System<SharedMapSystem>().GetAllTiles(grid, Comp<MapGridComponent>(grid))
+            .ToDictionary(tile => tile.GridIndices, tile => tile.Tile);
