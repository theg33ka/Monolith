+            maps.SetPaused(map.MapId, false);
+            Assert.That(Edit(KiasGraphEdit.Write), Is.False);
+            Assert.That(em.System<KiasSystem>().IsOnline(programmer), Is.False);
+        });
+        await pair.CleanReturnAsync();
+    }
