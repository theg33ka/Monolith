+++ b/Tools/KiasBenchmark/scanner_ui.ps1
@@ -0,0 +1,62 @@
+param([switch]$SkipBuild)
+$ErrorActionPreference = 'Stop'
+. (Join-Path $PSScriptRoot 'benchmark_lock.ps1')
+$taskLease=Enter-KiasBenchmarkLease (Join-Path $PSScriptRoot '../..')
+try {
+Test-KiasBenchmarkPorts
+$repo = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$output = Join-Path $repo ('.kias-benchmark/scanner-ui/' + (Get-Date -Format 'yyyyMMdd-HHmmss'))
+New-Item -ItemType Directory -Path $output -Force | Out-Null
+$oldOutput = $env:KIAS_LAB_SCANNER_OUTPUT
+$oldSandbox = $env:ROBUST_DISABLE_SANDBOX
+$server = $null
+$client = $null
+$sourceHashes = @{}
+$sourceFiles = @('Resources/Maps/_Forge/KIAS/Fixtures/briarKIAS.yml', 'Resources/Prototypes/_Forge/KIAS/controller_presets.yml', 'Tools/KiasBenchmark/Client/ScannerUiLab.cs', 'Tools/KiasBenchmark/Server/ScannerUiLab.cs')
+Push-Location $repo
+try {
+    & python (Join-Path $PSScriptRoot 'source_fingerprint.py') *> (Join-Path $output 'root-source-fingerprint.json')
+    if ($LASTEXITCODE -ne 0) { throw 'Source fingerprint failed.' }
+    $taskFingerprint=(Get-Content -LiteralPath (Join-Path $output 'root-source-fingerprint.json') -Raw | ConvertFrom-Json).sha256
+    foreach ($sourceFile in $sourceFiles) { $sourceHashes[$sourceFile] = (Get-FileHash -LiteralPath $sourceFile -Algorithm SHA256).Hash.ToLowerInvariant() }
+    if (-not $SkipBuild) {
+        & dotnet build Content.Server/Content.Server.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabScannerUi=true *> (Join-Path $output 'server-build.log')
+        if ($LASTEXITCODE -ne 0) { throw 'Diagnostic server build failed.' }
+        & dotnet build Content.Client/Content.Client.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabScannerUi=true *> (Join-Path $output 'client-build.log')
+        if ($LASTEXITCODE -ne 0) { throw 'Diagnostic client build failed.' }
+    }
+    $taskCurrentFingerprint=& python (Join-Path $PSScriptRoot 'source_fingerprint.py') | ConvertFrom-Json
+    if ($LASTEXITCODE -ne 0 -or $taskCurrentFingerprint.sha256 -ne $taskFingerprint) { throw 'Source changed during UI build.' }
+    foreach ($sourceFile in $sourceFiles) { if ((Get-FileHash -LiteralPath $sourceFile -Algorithm SHA256).Hash.ToLowerInvariant() -ne $sourceHashes[$sourceFile]) { throw 'Diagnostic sources changed during compilation; rerun the live check.' } }
+    $fingerprint = @{ sourceFingerprint = $taskFingerprint; sources = $sourceHashes; serverAssemblySha256 = (Get-FileHash -LiteralPath 'bin/Content.Server/Content.Server.dll' -Algorithm SHA256).Hash.ToLowerInvariant(); clientAssemblySha256 = (Get-FileHash -LiteralPath 'bin/Content.Client/Content.Client.dll' -Algorithm SHA256).Hash.ToLowerInvariant(); scope = 'Dedicated local server and native desktop client; automatic UI input handlers and real network BUI' }
+    $fingerprint | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $output 'run-manifest.json') -Encoding utf8
+    $env:KIAS_LAB_SCANNER_OUTPUT = $output
+    $env:ROBUST_DISABLE_SANDBOX = '1'
+    $serverArgs = @('--data-dir', (Join-Path $output 'data'), '--cvar', 'net.port=12301', '--cvar', 'net.bindto=127.0.0.1', '--cvar', 'game.auto_pause_empty=false', '--cvar', 'game.lobbyenabled=true', '--cvar', 'game.lobbyduration=999999', '--cvar', 'auth.mode=0', '+kias_lab_scanner_server')
+    $server = Start-Process -FilePath (Join-Path $repo 'bin/Content.Server/Content.Server.exe') -WorkingDirectory $repo -ArgumentList $serverArgs -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $output 'server.log') -RedirectStandardError (Join-Path $output 'server-error.log')
+    $deadline = (Get-Date).AddMinutes(3)
+    while (-not (Test-Path -LiteralPath (Join-Path $output 'server-bootstrap.json')) -and -not $server.HasExited -and (Get-Date) -lt $deadline) { Start-Sleep -Seconds 2; $server.Refresh() }
+    if (-not (Test-Path -LiteralPath (Join-Path $output 'server-bootstrap.json'))) { throw 'Live server fixture did not initialize.' }
+    $clientArgs = @('--connect', '--connect-address', 'udp://127.0.0.1:12301', '--username', 'KiasScannerLab', '--cvar', 'display.windowmode=0', '--cvar', 'culture=ru-RU', '--cvar', 'display.uiScale=1', '--cvar', 'interface.resolutionAutoScaleEnabled=false', '+kias_lab_scanner_client')
+    $client = Start-Process -FilePath (Join-Path $repo 'bin/Content.Client/Content.Client.exe') -WorkingDirectory $repo -ArgumentList $clientArgs -WindowStyle Hidden -PassThru -RedirectStandardOutput (Join-Path $output 'client.log') -RedirectStandardError (Join-Path $output 'client-error.log')
+    $deadline = (Get-Date).AddMinutes(8)
+    while ((-not (Test-Path -LiteralPath (Join-Path $output 'client-completed.json')) -or -not (Test-Path -LiteralPath (Join-Path $output 'server-completed.json'))) -and -not (Test-Path -LiteralPath (Join-Path $output 'client-failed.json')) -and -not (Test-Path -LiteralPath (Join-Path $output 'server-failed.json')) -and -not $client.HasExited -and -not $server.HasExited -and (Get-Date) -lt $deadline) { Start-Sleep -Seconds 2; $client.Refresh(); $server.Refresh() }
+    if (-not (Test-Path -LiteralPath (Join-Path $output 'client-completed.json'))) { throw "Live UI failed or timed out. See $output" }
+    if (-not (Test-Path -LiteralPath (Join-Path $output 'server-completed.json'))) { throw 'Server did not complete all scanner cases.' }
+    & python (Join-Path $PSScriptRoot 'validate_scanner_ui.py') $output
+    if ($LASTEXITCODE -ne 0) { throw 'Scanner UI evidence differs between server and client.' }
+    Write-Host "Actual scanner BUI/world overlay captured: $output"
+
+} finally {
+    if ($null -ne $client -and -not $client.HasExited) { Stop-Process -Id $client.Id }
+    if ($null -ne $server -and -not $server.HasExited) { Stop-Process -Id $server.Id }
+    $env:KIAS_LAB_SCANNER_OUTPUT = $oldOutput
+    $env:ROBUST_DISABLE_SANDBOX = $oldSandbox
+    & dotnet build Content.Server/Content.Server.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabScannerUi=false *> (Join-Path $output 'server-restore-build.log')
+    $serverRestore = $LASTEXITCODE
+    & dotnet build Content.Client/Content.Client.csproj -c Release --no-restore -m:4 -nr:false -p:KiasLabScannerUi=false *> (Join-Path $output 'client-restore-build.log')
+    if ($serverRestore -ne 0 -or $LASTEXITCODE -ne 0) { Write-Error "Normal builds did not restore; see $output" }
+    Pop-Location
+}
+
+} finally { Exit-KiasBenchmarkLease $taskLease }
diff --git a/Tools/KiasBenchmark/source_fingerprint.py b/Tools/KiasBenchmark/source_fingerprint.py
new file mode 100644
index 0000000000..1c3b132840
--- /dev/null
+++ b/Tools/KiasBenchmark/source_fingerprint.py
@@ -0,0 +1,39 @@
+"""Hash current laboratory inputs independently of previous compiled manifests."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def capture():
+    paths = set()
+    for relative in (
+        "Content.Server/_Forge/KIAS", "Content.Shared/_Forge/KIAS", "Content.Client/_Forge/KIAS",
+        "Content.IntegrationTests/Tests/_Forge/KIAS", "Resources/Prototypes/_Forge/KIAS",
+        "Resources/Locale/ru-RU/_Forge/KIAS", "Resources/Locale/en-US/_Forge/KIAS", "Tools/KiasBenchmark",
+        "Resources/Textures/_Forge/KIAS",
+    ):
+        paths.update(path for path in (ROOT / relative).rglob("*")
+                     if path.is_file() and path.suffix in (".cs", ".xaml", ".yml", ".ftl", ".py", ".ps1", ".md", ".json", ".png"))
+    for culture in ('ru-RU', 'en-US'):
+        paths.update((ROOT/f'Resources/Locale/{culture}/_Forge').glob('kias*.ftl'))
+    paths.update((ROOT / "Run_KIAS_Tests.bat", ROOT / "Resources/Maps/_Forge/KIAS/Fixtures/briarKIAS.yml"))
+    untracked = subprocess.check_output(["git", "-C", str(ROOT), "ls-files", "--others", "--exclude-standard", "-z"]).decode().split("\0")
+    paths.update(ROOT / name for name in untracked if name and not name.replace('\\', '/').startswith('KIAS_REVIEW/') and (ROOT / name).is_file()
+                 and Path(name).suffix in (".cs", ".csproj", ".props", ".targets", ".yml", ".ftl", ".json", ".py", ".ps1", ".md", ".bat"))
+    files = {path.relative_to(ROOT).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest() for path in sorted(paths)}
+    engine = subprocess.check_output(["git", "-C", str(ROOT / "RobustToolbox"), "rev-parse", "HEAD"], text=True).strip()
+    head = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+    working_patch = subprocess.check_output(["git", "-C", str(ROOT), "diff", "--binary", "HEAD"], stderr=subprocess.PIPE)
+    engine_patch = subprocess.check_output(["git", "-C", str(ROOT / "RobustToolbox"), "diff", "--binary", "HEAD"], stderr=subprocess.PIPE)
+    value = {"head": head, "engine": engine, "files": files,
+             "workingTreePatchSha256": hashlib.sha256(working_patch).hexdigest(),
+             "engineWorkingTreePatchSha256": hashlib.sha256(engine_patch).hexdigest()}
+    value["sha256"] = hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()
+    return value
+
+
+if __name__ == "__main__":
+    print(json.dumps(capture(), indent=2))
